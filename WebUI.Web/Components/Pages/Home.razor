    private static string GetTagStyle(TagDto tag)
    {
        var background = NormalizeTagColor(tag.Color);
        var foreground = GetReadableTagTextColor(background);
        return $"background-color: {background}; color: {foreground};";
    }

    private static string NormalizeTagColor(string? color)
    {
        if (string.IsNullOrWhiteSpace(color))
        {
            return "#e4e7ec";
        }

        var value = color.Trim();
        if (value.Length == 7 && value[0] == '#' &&
            value.Skip(1).All(Uri.IsHexDigit))
        {
            return value;
        }

        return "#e4e7ec";
    }

    private static string GetReadableTagTextColor(string background)
    {
        var red = Convert.ToInt32(background.Substring(1, 2), 16);
        var green = Convert.ToInt32(background.Substring(3, 2), 16);
        var blue = Convert.ToInt32(background.Substring(5, 2), 16);
        var luminance = (0.299 * red) + (0.587 * green) + (0.114 * blue);
        return luminance >= 150 ? "#101828" : "#ffffff";
    }

