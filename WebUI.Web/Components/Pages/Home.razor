    private async Task SelectDocumentAsync(DocumentListItemDto document)
    {
        var keepQuickLookOpen = _quickLookOpen;
        _selectedDocument = document;
        _quickLookNeedsFocus = keepQuickLookOpen;
        _documentDetails = null;
        _documentDetailsError = null;
        _thumbnailFailed = false;

        _documentDetailsCancellation?.Cancel();
        _documentDetailsCancellation?.Dispose();
        _documentDetailsCancellation = new CancellationTokenSource();
        var cancellationToken = _documentDetailsCancellation.Token;

        _isLoadingDocumentDetails = true;

        // v9.65.5: Die Auswahl und damit der Vorschau-Pfeil sollen sofort
        // sichtbar werden. Das Nachladen der Metadaten läuft anschließend
        // weiter und darf die Anzeige der Auswahl nicht verzögern.
        StateHasChanged();
        await Task.Yield();

        try
        {
            var client = GetPaperlessClient();
            var details = await client.GetDocumentAsync(document.Id, cancellationToken);

            if (!cancellationToken.IsCancellationRequested &&
                _selectedDocument?.Id == document.Id)
            {
                _documentDetails = details;
                if (details is null)
                {
                    _documentDetailsError = "Für dieses Dokument wurden keine Metadaten geliefert.";
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Ein schneller Dokumentwechsel verwirft die vorherige Anfrage.
        }
        catch
        {
            if (!cancellationToken.IsCancellationRequested &&
                _selectedDocument?.Id == document.Id)
            {
                _documentDetailsError = "Die Metadaten konnten nicht geladen werden.";
            }
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested &&
                _selectedDocument?.Id == document.Id)
            {
                _isLoadingDocumentDetails = false;
            }
        }
    }

