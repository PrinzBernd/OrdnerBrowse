        if (firstRender)
        {
            var renderWatch = Stopwatch.StartNew();
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "RENDER", "FIRST_RENDER", "START", 0);
            _infiniteScrollModule = await ImportPerformanceModuleAsync(
                "IMPORT_INFINITE_SCROLL",
                "./js/infiniteScroll.js");

            _listNavigationModule = await ImportPerformanceModuleAsync(
                "IMPORT_LIST_NAVIGATION",
                "./js/listNavigation.js");

            _previewResizeModule = await ImportPerformanceModuleAsync(
                "IMPORT_PREVIEW_RESIZE",
                "./js/previewResize.js");

            _quickLookResizeModule = await ImportPerformanceModuleAsync(
                "IMPORT_QUICK_LOOK_RESIZE",
                "./js/quickLookResize.js");

            _quickLookPdfModule = await ImportPerformanceModuleAsync(
                "IMPORT_QUICK_LOOK_PDF",
                "./js/quickLookPdf.js");

            _columnResizeModule = await ImportPerformanceModuleAsync(
                "IMPORT_COLUMN_RESIZE",
                "./js/columnResize.js");

            _documentLoadFooterModule = await ImportPerformanceModuleAsync(
                "IMPORT_DOCUMENT_LOAD_FOOTER",
                "./js/documentLoadFooter.js");

            _dotNetReference = DotNetObjectReference.Create(this);

            await _documentLoadFooterModule.InvokeVoidAsync(
                "attach",
                _documentsColumn);

            await _columnResizeModule.InvokeVoidAsync(
                "attach",
                _columnsContainer,
                150,
                150,
                150,
                210);
            renderWatch.Stop();
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "RENDER", "FIRST_RENDER", "OK", renderWatch.Elapsed.TotalMilliseconds);
        }

        if (_documentInspectorOpen &&
            _selectedDocument is not null &&
            !_thumbnailFailed &&
            _previewResizeModule is not null)
        {
            await _previewResizeModule.InvokeVoidAsync(
                "attach",
                _documentDetailTop,
                _documentPreviewFrame,
                _documentPreviewImage,
                _documentPreviewResizeHandle,
                150,
                460,
                220,
                16);
        }

        if (_quickLookOpen && _quickLookResizeModule is not null)
        {
            await _quickLookResizeModule.InvokeVoidAsync(
                "attach",
                _quickLookDialog,
                _quickLookContent,
                _quickLookDivider,
                _dotNetReference,
                300,
                420,
                260,
                500);
        }

        if (_quickLookOpen &&
            _selectedDocument is not null &&
            _quickLookPdfModule is not null)
        {
            await _quickLookPdfModule.InvokeVoidAsync(
                "attach",
                _quickLookPdfViewer,
                GetDocumentPreviewUrl(_selectedDocument.Id));
        }

        if (_quickLookOpen && _quickLookNeedsFocus)
        {
            _quickLookNeedsFocus = false;
            await _quickLookDialog.FocusAsync();
        }

        if (_columnToFocusAfterRender is not null && _listNavigationModule is not null)
        {
            var columnName = _columnToFocusAfterRender;
            _columnToFocusAfterRender = null;
            await _listNavigationModule.InvokeVoidAsync("focusColumn", columnName);
        }

        if (_infiniteScrollModule is not null &&
            _dotNetReference is not null &&
            _hasMoreDocuments &&
            !_isLoadingDocuments &&
            !_isLoadingMoreDocuments)
        {
            await _infiniteScrollModule.InvokeVoidAsync(
                "attach",
                _documentsScrollContainer,
                _dotNetReference);
        }

    }

    private async Task OnDocumentSearchInputAsync(ChangeEventArgs args)
    {
        _documentFilter = args.Value?.ToString() ?? string.Empty;
        var requestSearchVersion = ++_documentSearchVersion;
        await RefreshDocumentSearchAsync(requestSearchVersion, _documentFilter);
    }

    private async Task RefreshDocumentSearchAsync()
    {
        var requestSearchVersion = ++_documentSearchVersion;
        await RefreshDocumentSearchAsync(requestSearchVersion, _documentFilter);
    }

    private async Task RefreshDocumentSearchAsync(
        int requestSearchVersion,
        string requestedFilter)
    {
        _documentPage = 1;

        _hybridDocumentSearchCancellation?.Cancel();
        _hybridDocumentSearchCancellation?.Dispose();
        _hybridDocumentSearchCancellation = new CancellationTokenSource();
        var cancellationToken = _hybridDocumentSearchCancellation.Token;

        try
        {
            // Lokale und API-Suche verwenden dieselbe kurze Tipp-Pause.
            // Jede neuere Eingabe bricht diesen Lauf unmittelbar ab.
            await Task.Delay(275, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();

            if (requestSearchVersion != _documentSearchVersion ||
                !string.Equals(requestedFilter, _documentFilter, StringComparison.Ordinal))
            {
                return;
            }

            if (string.IsNullOrWhiteSpace(requestedFilter))
            {
                _isSearchingDocuments = false;

                if (_documentsAscending == _normalDocumentsAscending)
                {
                    RestoreNormalDocumentList();
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    // Die Sortierung wurde während der Suche geändert.
                    // Deshalb muss die normale Liste einmalig ab Seite 1
                    // in der neuen Reihenfolge geladen werden.
                    await InvokeAsync(StateHasChanged);
                    await LoadAllDocumentsForCurrentSelectionAsync();
                }

                return;
            }

            var allNormalDocumentsLoaded =
                _allDocumentsForCurrentSelection.Count == _normalDocumentTotalCount;

            if (allNormalDocumentsLoaded)
            {
                _isSearchingDocuments = false;
                ApplyLocalHybridTitleSearch();

                if (requestSearchVersion == _documentSearchVersion)
                {
                    await InvokeAsync(StateHasChanged);
                }

                return;
            }

            _isSearchingDocuments = true;
            await InvokeAsync(StateHasChanged);

            await ApplyApiHybridTitleSearchAsync(cancellationToken);

            cancellationToken.ThrowIfCancellationRequested();
            if (requestSearchVersion != _documentSearchVersion ||
                !string.Equals(requestedFilter, _documentFilter, StringComparison.Ordinal))
            {
                return;
            }
        }
        catch (OperationCanceledException)
        {
            // Eine neuere Eingabe, ein Auswahlwechsel oder das Leeren
            // des Feldes hat diese Suche ersetzt.
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested &&
                requestSearchVersion == _documentSearchVersion)
            {
                _isSearchingDocuments = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void LogPaperlessError(
        string action,
        PaperlessErrorInfo error,
        bool cacheContinues = false)
    {
        Logger.LogError(
            "Paperless-Aktion fehlgeschlagen. Ereigniskennung: {EventId}; Aktion: {Action}; Kategorie: {Category}; HTTP-Status: {StatusCode}; Ausnahmetyp: {ExceptionType}; Zeitüberschreitung: {IsTimeout}; Bestehender Stand weiterverwendet: {CacheContinues}",
            error.EventId,
            action,
            error.Category,
            error.StatusCode,
            error.ExceptionType,
            error.IsTimeout,
            cacheContinues);
    }

    private void RestoreNormalDocumentList()
    {
        _activeDocumentSearchResults = [];
        _documentsById = _allDocumentsForCurrentSelection.ToDictionary(document => document.Id);
        _documents = _allDocumentsForCurrentSelection.ToArray();
        _totalCount = _normalDocumentTotalCount;
        _hasMoreDocuments = _documents.Count < _normalDocumentTotalCount;
        ReconcileSelectionWithVisibleDocuments();
    }

    private void ApplyLocalHybridTitleSearch()
    {
        var groups = ParseTitleSearchGroups(_documentFilter);
        IEnumerable<DocumentListItemDto> source = _allDocumentsForCurrentSelection;

        if (_documentsAscending != _normalDocumentsAscending)
        {
            source = source.Reverse();
        }

        _activeDocumentSearchResults = groups.Count == 0
            ? []
            : source
                .Where(document => MatchesTitleSearch(document.Title, groups))
                .ToArray();

        ApplyActiveSearchResults();
    }

    private async Task ApplyApiHybridTitleSearchAsync(CancellationToken cancellationToken)
    {
        if (_selectedArea is null || _selectedCorrespondent is null || _selectedDocumentType is null)
        {
            return;
        }

        var groups = ParseTitleSearchGroups(_documentFilter);
        if (groups.Count == 0)
        {
            _activeDocumentSearchResults = [];
            ApplyActiveSearchResults();
            return;
        }

        var client = GetPaperlessClient();
        var candidates = new Dictionary<int, DocumentListItemDto>();

        foreach (var term in groups.SelectMany(group => group).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            cancellationToken.ThrowIfCancellationRequested();
            var matches = await client.GetAllDocumentsAsync(
                storagePathId: _selectedArea.StoragePathId > 0 ? _selectedArea.StoragePathId : null,
                storagePathIds: GetSelectedPrivateStoragePathIds(),
                storagePathIsNull: _selectedArea.StoragePathId == UnassignedAreaKey,
                correspondentId: _selectedCorrespondent.Id > 0 ? _selectedCorrespondent.Id : null,
                correspondentIds: GetSelectedPrivateCorrespondentIds(),
                correspondentIsNull: _selectedCorrespondent.Id == UnassignedSelectionId,
                documentTypeId: _selectedDocumentType.Id > 0 ? _selectedDocumentType.Id : null,
                documentTypeIds: GetSelectedPrivateDocumentTypeIds(),
                documentTypeIsNull: _selectedDocumentType.Id == UnassignedSelectionId,
                sortAscending: _documentsAscending,
                titleContains: term,
                cancellationToken: cancellationToken);

            foreach (var document in matches)
            {
                candidates[document.Id] = document;
            }
        }

        cancellationToken.ThrowIfCancellationRequested();
        _activeDocumentSearchResults = candidates.Values
            .Where(document => MatchesTitleSearch(document.Title, groups))
            .ToArray();
        ApplyActiveSearchResults();
    }

    private void ApplyActiveSearchResults()
    {
        _activeDocumentSearchResults = (_documentsAscending
            ? _activeDocumentSearchResults
                .OrderBy(document => document.CreatedUtc)
                .ThenBy(document => document.Id)
            : _activeDocumentSearchResults
                .OrderByDescending(document => document.CreatedUtc)
                .ThenByDescending(document => document.Id))
            .ToArray();

        _documentsById = _activeDocumentSearchResults.ToDictionary(document => document.Id);
        _totalCount = _activeDocumentSearchResults.Count;
        _documents = _activeDocumentSearchResults.Take(DocumentsPerBatch).ToArray();
        _hasMoreDocuments = _documents.Count < _totalCount;
        ReconcileSelectionWithVisibleDocuments();
    }

    private void ReconcileSelectionWithVisibleDocuments()
    {
        if (_selectedDocument is null)
        {
            return;
        }

        var matchingSelection = _documents.FirstOrDefault(document => document.Id == _selectedDocument.Id);
        if (matchingSelection is null)
        {
            ClearDocumentDetails();
        }
        else
        {
            _selectedDocument = matchingSelection;
        }
    }

    private static IReadOnlyList<IReadOnlyList<string>> ParseTitleSearchGroups(string? searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return Array.Empty<IReadOnlyList<string>>();
        }

        return searchText
            .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(orGroup => (IReadOnlyList<string>)orGroup
                .Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(term => !string.IsNullOrWhiteSpace(term))
                .ToArray())
            .Where(group => group.Count > 0)
            .ToArray();
    }

    private static bool MatchesTitleSearch(
        string? title,
        IReadOnlyList<IReadOnlyList<string>> groups)
    {
        if (groups.Count == 0)
        {
            return true;
        }

        var searchableTitle = title ?? string.Empty;

        return groups.Any(group =>
            group.All(term => searchableTitle.Contains(
                term,
                StringComparison.OrdinalIgnoreCase)));
    }

