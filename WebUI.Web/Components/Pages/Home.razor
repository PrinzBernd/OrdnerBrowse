    private IReadOnlyList<DisplayedCustomField> GetSelectedDocumentCustomFields()
    {
        if (_selectedDocument is null || _selectedDocument.CustomFields.Count == 0)
        {
            return [];
        }

        var definitions = _allCustomFields.ToDictionary(field => field.Id);
        var result = new List<DisplayedCustomField>();

        foreach (var value in _selectedDocument.CustomFields)
        {
            if (!definitions.TryGetValue(value.FieldId, out var definition))
            {
                continue;
            }

            var displayValue = FormatCustomFieldValue(definition, value.Value);
            result.Add(new DisplayedCustomField(
                definition.Name,
                displayValue ?? string.Empty,
                string.IsNullOrWhiteSpace(displayValue)));
        }

        return result
            .OrderBy(field => field.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();
    }

    private static string? FormatCustomFieldValue(CustomFieldDto field, object? rawValue)
    {
        if (rawValue is null)
        {
            return null;
        }

        var value = rawValue is JsonElement element
            ? element
            : JsonSerializer.SerializeToElement(rawValue);

        if (value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return null;
        }

        return field.DataType.ToLowerInvariant() switch
        {
            "boolean" or "bool" => value.ValueKind == JsonValueKind.True
                ? "Ja"
                : value.ValueKind == JsonValueKind.False
                    ? "Nein"
                    : value.ToString(),
            "date" => DateOnly.TryParse(value.ToString(), out var date)
                ? date.ToString("dd.MM.yyyy")
                : value.ToString(),
            "select" => GetSelectLabel(field, value.ToString()),
            "documentlink" => FormatDocumentLinks(value),
            "monetary" => FormatMonetaryValue(value.ToString()),
            _ => FormatJsonValue(value)
        };
    }

    private static string? GetSelectLabel(CustomFieldDto field, string selectedId)
    {
        if (field.ExtraData.ValueKind == JsonValueKind.Object &&
            field.ExtraData.TryGetProperty("select_options", out var options) &&
            options.ValueKind == JsonValueKind.Array)
        {
            foreach (var option in options.EnumerateArray())
            {
                if (option.TryGetProperty("id", out var id) &&
                    id.ToString() == selectedId &&
                    option.TryGetProperty("label", out var label))
                {
                    return label.ToString();
                }
            }
        }

        return string.IsNullOrWhiteSpace(selectedId) ? null : selectedId;
    }

    private static string? FormatDocumentLinks(JsonElement value)
    {
        if (value.ValueKind != JsonValueKind.Array)
        {
            return FormatJsonValue(value);
        }

        var ids = value.EnumerateArray()
            .Select(item => item.ToString())
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .ToArray();

        return ids.Length == 0
            ? null
            : string.Join(", ", ids.Select(id => $"Dokument {id}"));
    }

    private static string? FormatMonetaryValue(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (value.Length > 3 && char.IsLetter(value[0]) &&
            char.IsLetter(value[1]) && char.IsLetter(value[2]))
        {
            return $"{value[3..]} {value[..3]}";
        }

        return value;
    }

    private static string? FormatJsonValue(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String => string.IsNullOrWhiteSpace(value.GetString())
                ? null
                : value.GetString(),
            JsonValueKind.Number => FormatJsonNumber(value),
            JsonValueKind.True => "Ja",
            JsonValueKind.False => "Nein",
            JsonValueKind.Array => string.Join(", ", value.EnumerateArray().Select(item => item.ToString())),
            JsonValueKind.Object => value.ToString(),
            _ => null
        };
    }

    private static string FormatJsonNumber(JsonElement value)
    {
        var culture = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

        if (value.TryGetInt64(out var integer))
        {
            return integer.ToString(culture);
        }

        if (value.TryGetDecimal(out var number))
        {
            return number == decimal.Truncate(number)
                ? decimal.Truncate(number).ToString("0", culture)
                : number.ToString("0.############################", culture);
        }

        if (value.TryGetDouble(out var floatingPointNumber))
        {
            return Math.Abs(floatingPointNumber - Math.Truncate(floatingPointNumber)) < 0.0000000001
                ? Math.Truncate(floatingPointNumber).ToString("0", culture)
                : floatingPointNumber.ToString("0.################", culture);
        }

        return value.ToString();
    }

