    private async Task ReconcileSelectedDocumentAfterReloadAsync(
        int? selectedDocumentIdBeforeReload,
        int requestSearchVersion)
    {
        if (!selectedDocumentIdBeforeReload.HasValue ||
            requestSearchVersion != _documentSearchVersion ||
            _selectedDocument?.Id != selectedDocumentIdBeforeReload.Value)
        {
            return;
        }

        var refreshedDocument = _allDocumentsForCurrentSelection.FirstOrDefault(
            document => document.Id == selectedDocumentIdBeforeReload.Value);

        if (refreshedDocument is null)
        {
            // Das Dokument wurde gelöscht oder gehört nach einer Zuordnungsänderung
            // nicht mehr zur aktuell ausgewählten Kombination.
            ClearDocumentDetails();
            _columnToFocusAfterRender = "document";
            return;
        }

        // Das Dokument ist weiterhin vorhanden. Auswahl, Tags, benutzerdefinierte
        // Felder und Detaildaten werden auf das neu geladene Objekt umgestellt.
        await SelectDocumentAsync(refreshedDocument);
    }

