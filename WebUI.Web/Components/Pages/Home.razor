    private IReadOnlyCollection<int>? GetSelectedPrivateDocumentTypeIds()
    {
        if (_selectedDocumentType?.Id != PrivateSelectionId) return null;
        var readable = _allDocumentTypes.Select(item => item.Id).ToHashSet();
        return DocumentsForSelectedArea()
            .Where(document => document.DocumentTypeId.HasValue && !readable.Contains(document.DocumentTypeId.Value))
            .Where(document => _selectedCorrespondent?.Id switch
            {
                AllSelectionId => true,
                UnassignedSelectionId => !document.CorrespondentId.HasValue,
                PrivateSelectionId => document.CorrespondentId.HasValue &&
                    !_allCorrespondents.Any(item => item.Id == document.CorrespondentId.Value),
                > 0 => document.CorrespondentId == _selectedCorrespondent.Id,
                _ => false
            })
            .Select(document => document.DocumentTypeId!.Value).Distinct().ToArray();
    }

