@page "/documents"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using WebUI.Infrastructure
@using System.Text.Json
@using System.Diagnostics
@using WebUI.Web.Services
@inject PaperlessClientFactory ClientFactory
@inject OidcAuthenticationSettings OidcSettings
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation
@inject NavigationCacheService NavigationCache
@inject CentralNavigationSyncService CentralSync
@inject DisplayPrefixService DisplayPrefixes
@inject UserSessionRegistry UserSessions
@inject CircuitConnectionState CircuitConnection
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@implements IAsyncDisposable

<PageTitle>@ApplicationDisplayInfo.FullProductName</PageTitle>

<div class="explorer">
    <div class="toolbar">
        <div class="toolbar-title" data-quick-look-anchor>
            <strong>Dokumenten-Explorer</strong>
        </div>

        <div class="toolbar-status-row">
            <span class="navigation-cache-status">@NavigationStatusText</span>
            <button class="refresh-button"
                    type="button"
                    disabled="@(_isRefreshingNavigation || _navigationCacheKey is null)"
                    @onclick="RefreshNavigationAsync">
                @(_isRefreshingNavigation ? "Wird geprüft …" : "Aktualisieren")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="status error" role="alert">@_errorMessage</div>
    }

    <div class="columns" @ref="_columnsContainer">
        <section data-column="area" class="column @CollapsedClass(_areasCollapsed)" tabindex="0" @onfocusin="CloseDocumentInspector" @onkeydown="HandleAreaKeyDownAsync">
            @if (_areasCollapsed)
            {
                <button type="button" class="collapsed-rail" title="Bereiche wieder aufklappen" aria-label="Bereiche wieder aufklappen" aria-expanded="false" @onclick="ExpandAreas">
                    <span>Bereiche</span><span class="column-expand-icon fold-chevron fold-chevron-right" aria-hidden="true"></span>
                </button>
            }
            else
            {
                <header>
                    <h2>Bereiche</h2>
                    <div class="column-tools">
                        <span>@NormalAreaCount</span>
                        <button type="button" class="icon-button" title="Sortierreihenfolge wechseln" @onclick="ToggleAreaSort">@SortArrow(_areasDescending)</button>
                        <button type="button" class="icon-button column-collapse-icon" title="Spalte einklappen" aria-label="Spalte einklappen" aria-expanded="true" disabled="@(_selectedArea is null)" @onclick="CollapseAreas"><span class="fold-chevron fold-chevron-left" aria-hidden="true"></span></button>
                    </div>
                </header>
                <div class="items">
                    <button type="button" class="row area-row @SelectedAreaClass(AllAreas)"
                            aria-label="Gesamtübersicht auswählen" @onclick="() => SelectAreaAsync(AllAreas)">
                        <span class="row-main">Gesamtübersicht</span>
                        <span class="area-stats">
                            <span class="area-stats-line">@FormatCorrespondentNumber(TotalCorrespondentCount)</span>
                            <span class="area-stats-line">@FormatDocumentCount(TotalDocumentCount)</span>
                        </span>
                    </button>

                    @foreach (var area in SortedAreas)
                    {
                        <button id="@AreaElementId(area)" class="row area-row @SelectedAreaClass(area)" @onclick="() => SelectAreaAsync(area)">
                            <span class="row-main">@DisplayAreaName(area.DisplayName)</span>
                            @if (area.StoragePathId == UnassignedAreaKey)
                            {
                                <span class="area-stats">
                                    <span class="area-stats-line">@FormatCorrespondentNumber(GetAreaCorrespondentCount(area))</span>
                                    <span class="area-stats-line">@FormatDocumentCount(GetAreaDocumentCount(area))</span>
                                </span>
                            }
                            else
                            {
                                <span class="area-stats">
                                    <span class="area-stats-line">@GetAreaCorrespondentCount(area).ToString("N0") Korrespondenten</span>
                                    <span class="area-stats-line">@GetAreaDocumentCount(area).ToString("N0") Dokumente</span>
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(area.PaperlessName))
                            {
                                <span class="row-detail">@area.PaperlessName</span>
                            }
                            <span class="chevron">›</span>
                        </button>
                        @if (area.StoragePathId == UnassignedAreaKey)
                        {
                            <div class="special-separator" aria-hidden="true"></div>
                        }
                    }
                </div>
            }
        </section>

        <div class="main-column-resizer" data-column-resizer="0" title="Spaltenbreite mit der Maus ändern" aria-hidden="true"></div>

        <section data-column="correspondent" class="column compact-text @CollapsedClass(_correspondentsCollapsed)" tabindex="0" @onfocusin="CloseDocumentInspector" @onkeydown="HandleCorrespondentKeyDownAsync">
            @if (_correspondentsCollapsed)
            {
                <button type="button" class="collapsed-rail" title="Korrespondenten wieder aufklappen" aria-label="Korrespondenten wieder aufklappen" aria-expanded="false" @onclick="ExpandCorrespondents">
                    <span>Korrespondenten</span><span class="column-expand-icon fold-chevron fold-chevron-right" aria-hidden="true"></span>
                </button>
            }
            else
            {
                <header>
                    <h2>Korrespondenten</h2>
                    <div class="column-tools">
                        @if (!_isLoadingArea && _selectedArea is not null)
                        {
                            <span>@FilteredCorrespondentCount</span>
                        }
                        <button type="button" class="icon-button" title="Sortierreihenfolge wechseln" @onclick="ToggleCorrespondentSort">@SortArrow(_correspondentsDescending)</button>
                        <button type="button" class="icon-button column-collapse-icon" title="Spalte einklappen" aria-label="Spalte einklappen" aria-expanded="true" disabled="@(_selectedCorrespondent is null)" @onclick="CollapseCorrespondents"><span class="fold-chevron fold-chevron-left" aria-hidden="true"></span></button>
                    </div>
                </header>
                @if (_selectedArea is null)
                {
                    <div class="empty-state"><strong>Bereich auswählen</strong></div>
                }
                else if (!_areInitialReferenceDataReady)
                {
                    <div class="empty-state" role="status">
                        <strong>Korrespondenten werden geladen …</strong>
                        <span>Die Navigation aus dem Cache ist bereits verfügbar.</span>
                    </div>
                }
                else if (_isLoadingArea)
                {
                    <div class="empty-state" role="status">
                        <strong>Korrespondenten werden aufgebaut …</strong>
                        <span>@ProgressText</span>
                        <progress max="100" value="@_progressPercent"></progress>
                        <span>Es werden nur IDs gelesen; keine Titel oder OCR-Inhalte.</span>
                    </div>
                }
                else
                {
                    <div class="column-search">
                        <input value="@_localFilter" @oninput="OnLocalFilterInput" @onkeydown:stopPropagation="true" placeholder="Korrespondenten filtern …" aria-label="Geladene Korrespondenten filtern" />
                    </div>
                    @if (FilteredCorrespondents.Count == 0)
                    {
                        <div class="empty-state"><strong>Keine Korrespondenten gefunden</strong></div>
                    }
                    else
                    {
                        <div class="items">
                            @foreach (var correspondent in FilteredCorrespondents)
                            {
                                <button id="@CorrespondentElementId(correspondent)" class="row @SelectedCorrespondentClass(correspondent)" @onclick="() => SelectCorrespondent(correspondent)">
                                    <span class="row-main">@DisplayCorrespondentName(correspondent.Name)</span>
                                    <span class="row-subline">@FormatCorrespondentCount(correspondent)</span>
                                    <span class="chevron">›</span>
                                </button>
                                @if (correspondent.Id == UnassignedSelectionId)
                                {
                                    <div class="special-separator" aria-hidden="true"></div>
                                }
                            }
                        </div>
                    }
                }
            }
        </section>

        <div class="main-column-resizer" data-column-resizer="1" title="Spaltenbreite mit der Maus ändern" aria-hidden="true"></div>

        <section data-column="document-type" class="column compact-text @CollapsedClass(_documentTypesCollapsed)" tabindex="0" @onfocusin="CloseDocumentInspector" @onkeydown="HandleDocumentTypeKeyDownAsync">
            @if (_documentTypesCollapsed)
            {
                <button type="button" class="collapsed-rail" title="Dokumenttypen wieder aufklappen" aria-label="Dokumenttypen wieder aufklappen" aria-expanded="false" @onclick="ExpandDocumentTypes">
                    <span>Dokumenttypen</span><span class="column-expand-icon fold-chevron fold-chevron-right" aria-hidden="true"></span>
                </button>
            }
            else
            {
                <header>
                    <h2>Dokumenttypen</h2>
                    <div class="column-tools">
                        @if (_selectedCorrespondent is not null)
                        {
                            <span>@VisibleDocumentTypeCount</span>
                        }
                        <button type="button" class="icon-button" title="Sortierreihenfolge wechseln" @onclick="ToggleDocumentTypeSort">@SortArrow(_documentTypesDescending)</button>
                        <button type="button" class="icon-button column-collapse-icon" title="Spalte einklappen" aria-label="Spalte einklappen" aria-expanded="true" disabled="@(_selectedDocumentType is null)" @onclick="CollapseDocumentTypes"><span class="fold-chevron fold-chevron-left" aria-hidden="true"></span></button>
                    </div>
                </header>
                @if (_selectedCorrespondent is null)
                {
                    <div class="empty-state"><strong>Korrespondent auswählen</strong></div>
                }
                else if (!_areInitialReferenceDataReady)
                {
                    <div class="empty-state" role="status"><strong>Dokumenttypen werden geladen …</strong></div>
                }
                else if (_documentTypes.Count == 0)
                {
                    <div class="empty-state"><strong>Keine Dokumenttypen gefunden</strong></div>
                }
                else
                {
                    <div class="column-search">
                        <input value="@_documentTypeFilter" @oninput="OnDocumentTypeFilterInput" @onkeydown:stopPropagation="true" placeholder="Dokumenttypen filtern …" aria-label="Dokumenttypen filtern" />
                    </div>
                    @if (FilteredDocumentTypes.Count == 0)
                    {
                        <div class="empty-state"><strong>Keine Dokumenttypen gefunden</strong></div>
                    }
                    else
                    {
                    <div class="items">
                        @foreach (var documentType in FilteredDocumentTypes)
                        {
                            <button id="@DocumentTypeElementId(documentType)" class="row @SelectedDocumentTypeClass(documentType)" @onclick="() => LoadDocumentsAsync(documentType)">
                                <span class="row-main">@DisplayDocumentTypeName(documentType.Name)</span>
                                <span class="row-subline">@FormatDocumentCount(GetDocumentTypeDocumentCount(documentType))</span>
                                <span class="chevron">›</span>
                            </button>
                            @if (documentType.Id == UnassignedSelectionId)
                            {
                                <div class="special-separator" aria-hidden="true"></div>
                            }
                        }
                    </div>
                    }
                }
            }
        </section>

        <div class="main-column-resizer" data-column-resizer="2" title="Spaltenbreite mit der Maus ändern" aria-hidden="true"></div>

        <section data-column="document" class="column documents-column compact-text @(_documentInspectorOpen ? "inspector-open" : null)" tabindex="0" @ref="_documentsColumn" @onkeydown="HandleDocumentKeyDownAsync">
            <header>
                <h2>Dokumente</h2>
                <div class="column-tools">
                    @if (_selectedDocumentType is not null)
                    {
                        <span id="document-count">@_totalCount.ToString("N0")</span>
                    }
                    <button type="button" class="icon-button" title="Sortierreihenfolge wechseln" @onclick="ToggleDocumentSortAsync">@SortArrow(!_documentsAscending)</button>
                    @if (_selectedDocument is not null)
                    {
                        <button type="button"
                                class="icon-button preview-toggle-icon"
                                title="@(_documentInspectorOpen ? "Vorschau schließen" : "Vorschau anzeigen")"
                                aria-label="@(_documentInspectorOpen ? "Vorschau schließen" : "Vorschau anzeigen")"
                                aria-expanded="@_documentInspectorOpen"
                                @onclick="ToggleDocumentInspector">
                            <span class="preview-chevron @(_documentInspectorOpen ? "preview-chevron-up" : "preview-chevron-down")" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </header>
            @if (_selectedDocumentType is not null)
            {
                <div class="column-search document-search-shell">
                    <input id="document-search-input"
                           @ref="_documentSearchInput"
                           value="@_documentFilter"
                           @oninput="OnDocumentSearchInputAsync"
                           @onkeydown:stopPropagation="true"
                           placeholder="Dokumenttitel suchen …"
                           aria-label="Dokumenttitel im ausgewählten Bereich suchen"
                           aria-busy="@_isSearchingDocuments" />
                    <span class="document-search-runtime" aria-live="polite">@(_isSearchingDocuments ? "Suche läuft …" : string.Empty)</span>
                </div>
            }
            @if (_isLoadingDocuments)
            {
                <div class="empty-state" role="status"><strong>Dokumente werden geladen …</strong></div>
            }
            else if (_selectedDocumentType is null)
            {
                <div class="empty-state"><strong>Dokumenttyp auswählen</strong></div>
            }
            else
            {
                <div class="items documents-scroll" @ref="_documentsScrollContainer" aria-live="polite">
                    @if (_documents.Count == 0)
                    {
                        <div class="empty-state"><strong>Keine Dokumente gefunden</strong></div>
                    }
                    else
                    {
                        @foreach (var document in _documents)
                        {
                            <div class="document-row-shell @(SelectedDocumentClass(document))" @key="document.Id">
                                <button type="button"
                                        id="@DocumentElementId(document)"
                                        class="row document-row"
                                        @onclick="() => SelectDocumentAsync(document)">
                                    <span class="row-main">@DisplayDocumentName(document.Title)</span>
                                    <span class="row-detail">ID @document.Id · @(document.PageCount?.ToString() ?? "–") Seite(n) · @document.TagIds.Count Tag(s)</span>
                                </button>
                                @if (_selectedDocument?.Id == document.Id)
                                {
                                    <button type="button"
                                            class="quick-look-row-button"
                                            title="Schnellansicht öffnen"
                                            aria-label="Schnellansicht öffnen"
                                            @onclick="OpenQuickLook">
                                        <svg class="quick-look-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.8"></circle></svg>
                                    </button>
                                    <a class="paperless-edit-link"
                                       href="@GetPaperlessDocumentUrl(document.Id)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       data-tooltip="In paperless-ngx öffnen"
                                       aria-label="In paperless-ngx öffnen">
                                        <img src="images/open-in-paperless.svg" alt="" />
                                    </a>
                                }
                            </div>
                        }
                    }
                </div>

                @if (!_documentInspectorOpen &&
                     string.IsNullOrWhiteSpace(_documentFilter) &&
                     _documents.Count > 0)
                {
                    <div class="document-load-footer" role="status" aria-live="polite">
                        @if (_hasMoreDocuments)
                        {
                            <span>
                                @_allDocumentsForCurrentSelection.Count.ToString("N0") Dokumente von @_normalDocumentTotalCount.ToString("N0") geladen …
                            </span>
                        }
                        else
                        {
                            <span>Alle @_normalDocumentTotalCount.ToString("N0") Dokumente geladen</span>
                        }
                    </div>
                }
            }

            @if (_selectedDocument is not null && _documentInspectorOpen)
            {
                var selectedCustomFields = GetSelectedDocumentCustomFields();
                var selectedTags = GetSelectedDocumentTags();
                var hasDocumentSideDetails = selectedCustomFields.Count > 0 || selectedTags.Count > 0;

                <div class="document-inspector">
                    <div class="document-detail-top @(hasDocumentSideDetails ? "has-side-details" : "preview-only")" @ref="_documentDetailTop">
                        <section class="document-preview" aria-label="Dokumentvorschau">
                            <header>
                                <h2>Vorschau</h2>
                            </header>

                            @if (_thumbnailFailed)
                            {
                                <div class="document-preview-state">Für dieses Dokument ist keine Vorschau verfügbar.</div>
                            }
                            else
                            {
                                <div class="document-preview-frame" @ref="_documentPreviewFrame">
                                    <button type="button"
                                            class="document-preview-image-button"
                                            title="Schnellansicht öffnen"
                                            aria-label="Schnellansicht öffnen"
                                            @onclick="OpenQuickLook">
                                        <img @key="_selectedDocument.Id"
                                             @ref="_documentPreviewImage"
                                             src="@GetThumbnailUrl(_selectedDocument.Id)"
                                             alt="Vorschau des ausgewählten Dokuments"
                                             @onerror="HandleThumbnailError" />
                                    </button>
                                    <div class="preview-resize-handle"
                                         @ref="_documentPreviewResizeHandle"
                                         title="Vorschauhöhe mit der Maus ändern"
                                         aria-label="Vorschauhöhe mit der Maus ändern"></div>
                                </div>
                            }
                        </section>

                        @if (hasDocumentSideDetails)
                        {
                            <div class="document-detail-side">
                                @if (selectedCustomFields.Count > 0)
                                {
                                    <section class="document-custom-fields" aria-label="Benutzerdefinierte Felder des Dokuments">
                                        <header>
                                            <h2>Benutzerdefinierte Felder</h2>
                                        </header>

                                        <dl class="custom-fields-grid">
                                            @foreach (var field in selectedCustomFields)
                                            {
                                                <div>
                                                    <dt>@field.Name</dt>
                                                    @if (field.IsEmpty)
                                                    {
                                                        <dd class="custom-field-empty">leer</dd>
                                                    }
                                                    else
                                                    {
                                                        <dd>@field.DisplayValue</dd>
                                                    }
                                                </div>
                                            }
                                        </dl>
                                    </section>
                                }

                                @if (selectedTags.Count > 0)
                                {
                                    <section class="document-tags" aria-label="Tags des Dokuments">
                                        <header>
                                            <h2>Tags</h2>
                                        </header>

                                        <div class="document-tags-list">
                                            @foreach (var tag in selectedTags)
                                            {
                                                <span class="document-tag"
                                                      style="@GetTagStyle(tag)"
                                                      title="@tag.Name">@tag.Name</span>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                    </div>

                    <section class="document-details" aria-label="Dokumentdetails">
                        <header>
                            <h2>Metadaten</h2>
                        </header>

                        @if (_isLoadingDocumentDetails)
                        {
                            <div class="document-details-state" role="status">Metadaten werden geladen …</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_documentDetailsError))
                        {
                            <div class="document-details-state error" role="alert">@_documentDetailsError</div>
                        }
                        else if (_documentDetails is not null)
                        {
                            <dl class="metadata-grid">
                                <div><dt>Titel</dt><dd>@DisplayMetadataValue(_documentDetails.Title)</dd></div>
                                <div><dt>Korrespondent</dt><dd>@GetCorrespondentName(_documentDetails.CorrespondentId)</dd></div>
                                <div><dt>Dokumenttyp</dt><dd>@GetDocumentTypeName(_documentDetails.DocumentTypeId)</dd></div>
                                <div><dt>Bereich</dt><dd>@GetStoragePathName(_documentDetails.StoragePathId)</dd></div>
                                <div><dt>Erstellt</dt><dd>@FormatMetadataDate(_documentDetails.CreatedUtc)</dd></div>
                                <div><dt>Hinzugefügt</dt><dd>@FormatMetadataDate(_documentDetails.AddedUtc)</dd></div>
                                <div><dt>Geändert</dt><dd>@FormatMetadataDate(_documentDetails.ModifiedUtc)</dd></div>
                                <div><dt>Seiten</dt><dd>@(_documentDetails.PageCount?.ToString("N0") ?? "–")</dd></div>
                                <div><dt>Dateityp</dt><dd>@DisplayMetadataValue(_documentDetails.MimeType)</dd></div>
                                <div><dt>Originaldatei</dt><dd>@DisplayMetadataValue(_documentDetails.OriginalFileName)</dd></div>
                                <div><dt>Archivnummer</dt><dd>@(_documentDetails.ArchiveSerialNumber?.ToString("N0") ?? "–")</dd></div>
                                <div><dt>Dokument-ID</dt><dd>@_documentDetails.Id</dd></div>
                            </dl>

                            @if (_documentDetails.Notes.Any(note => !string.IsNullOrWhiteSpace(note.Note)))
                            {
                                <header>
                                    <h2>Notizen</h2>
                                </header>

                                @foreach (var note in _documentDetails.Notes.Where(note => !string.IsNullOrWhiteSpace(note.Note)))
                                {
                                    <article class="quick-look-note">
                                        <div class="quick-look-note-text">@note.Note</div>
                                        <div class="quick-look-note-info">@FormatQuickLookNoteInfo(note)</div>
                                    </article>
                                }
                            }
                        }
                    </section>
                </div>
            }
        </section>
    </div>

    <footer class="statusbar">
        <div class="footer-selection" aria-label="Aktuelle Ablageauswahl">
            <span class="footer-path footer-path-full">
                @if (_selectedArea is not null)
                {
                    <span>@DisplayAreaName(_selectedArea.DisplayName)</span>
                }
                @if (_selectedCorrespondent is not null)
                {
                    <span class="footer-separator"> › </span><span>@DisplayCorrespondentName(_selectedCorrespondent.Name)</span>
                }
                @if (_selectedDocumentType is not null)
                {
                    <span class="footer-separator"> › </span><span>@DisplayDocumentTypeName(_selectedDocumentType.Name)</span>
                }
            </span>

            <span class="footer-path footer-path-no-area" aria-hidden="true">
                <span>…</span>
                @if (_selectedCorrespondent is not null)
                {
                    <span class="footer-separator"> › </span><span>@DisplayCorrespondentName(_selectedCorrespondent.Name)</span>
                }
                @if (_selectedDocumentType is not null)
                {
                    <span class="footer-separator"> › </span><span>@DisplayDocumentTypeName(_selectedDocumentType.Name)</span>
                }
            </span>

            <span class="footer-path footer-path-type-only" aria-hidden="true">
                <span>…</span>
                @if (_selectedDocumentType is not null)
                {
                    <span class="footer-separator"> › </span><span>@DisplayDocumentTypeName(_selectedDocumentType.Name)</span>
                }
            </span>

            <span class="footer-count">@FooterSelectionCountText</span>
        </div>
        <span class="footer-system">@PaperlessFooterText</span>
    </footer>
</div>

@if (_quickLookOpen && _selectedDocument is not null)
{
    var quickLookFields = GetSelectedDocumentCustomFields();
    var quickLookTags = GetSelectedDocumentTags();

    <div class="quick-look-backdrop"
         role="presentation"
         @onclick="CloseQuickLook">
        <section class="quick-look-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-label="Schnellansicht des ausgewählten Dokuments"
                 tabindex="-1"
                 @ref="_quickLookDialog"
                 @onclick:stopPropagation="true"
                 @onkeydown="HandleQuickLookKeyDown">
            <header class="quick-look-header" data-quick-look-drag-handle>
                <h2>Schnellansicht</h2>
                <button type="button"
                        class="quick-look-close"
                        title="Schnellansicht schließen"
                        aria-label="Schnellansicht schließen"
                        @onclick="CloseQuickLook">×</button>
            </header>

            <div class="quick-look-content" @ref="_quickLookContent">
                <div class="quick-look-divider"
                     @ref="_quickLookDivider"
                     title="Größe des Informationsbereichs ändern"
                     aria-label="Größe des Informationsbereichs ändern"></div>
                <div class="quick-look-preview">
                    <div class="quick-look-pdf-viewer"
                         @ref="_quickLookPdfViewer"
                         role="region"
                         aria-label="Mehrseitige Vorschau des ausgewählten Dokuments"></div>
                </div>

                <aside class="quick-look-information">
                    @if (quickLookFields.Count > 0)
                    {
                        <section class="quick-look-section">
                            <h3>Benutzerdefinierte Felder</h3>
                            <dl class="quick-look-fields">
                                @foreach (var field in quickLookFields)
                                {
                                    <div>
                                        <dt>@field.Name</dt>
                                        <dd class="@(field.IsEmpty ? "custom-field-empty" : null)">@(field.IsEmpty ? "leer" : field.DisplayValue)</dd>
                                    </div>
                                }
                            </dl>
                        </section>
                    }

                    @if (quickLookTags.Count > 0)
                    {
                        <section class="quick-look-section">
                            <h3>Tags</h3>
                            <div class="document-tags-list quick-look-tags">
                                @foreach (var tag in quickLookTags)
                                {
                                    <span class="document-tag" style="@GetTagStyle(tag)" title="@tag.Name">@tag.Name</span>
                                }
                            </div>
                        </section>
                    }

                    <section class="quick-look-section">
                        <h3>Metadaten</h3>
                        @if (_isLoadingDocumentDetails)
                        {
                            <div class="quick-look-state" role="status">Metadaten werden geladen …</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_documentDetailsError))
                        {
                            <div class="quick-look-state error" role="alert">@_documentDetailsError</div>
                        }
                        else if (_documentDetails is not null)
                        {
                            <dl class="quick-look-metadata">
                                <div><dt>Titel</dt><dd>@DisplayMetadataValue(_documentDetails.Title)</dd></div>
                                <div><dt>Korrespondent</dt><dd>@GetCorrespondentName(_documentDetails.CorrespondentId)</dd></div>
                                <div><dt>Dokumenttyp</dt><dd>@GetDocumentTypeName(_documentDetails.DocumentTypeId)</dd></div>
                                <div><dt>Bereich</dt><dd>@GetStoragePathName(_documentDetails.StoragePathId)</dd></div>
                                <div><dt>Erstellt</dt><dd>@FormatMetadataDate(_documentDetails.CreatedUtc)</dd></div>
                                <div><dt>Geändert</dt><dd>@FormatMetadataDate(_documentDetails.ModifiedUtc)</dd></div>
                                <div><dt>Seiten</dt><dd>@(_documentDetails.PageCount?.ToString("N0") ?? "–")</dd></div>
                                <div><dt>Dateityp</dt><dd>@DisplayMetadataValue(_documentDetails.MimeType)</dd></div>
                                <div><dt>Originaldatei</dt><dd>@DisplayMetadataValue(_documentDetails.OriginalFileName)</dd></div>
                                <div><dt>Dokument-ID</dt><dd>@_documentDetails.Id</dd></div>
                            </dl>
                        }
                    </section>

                    @if (_documentDetails is not null &&
                         _documentDetails.Notes.Any(note => !string.IsNullOrWhiteSpace(note.Note)))
                    {
                        <section class="quick-look-section">
                            <h3>Notizen</h3>
