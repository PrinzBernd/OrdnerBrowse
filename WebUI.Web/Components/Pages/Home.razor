    private async Task<T> MeasurePerformanceAsync<T>(
        string dataClass,
        string operation,
        Func<Task<T>> action,
        Func<T, string>? details = null)
    {
        var watch = Stopwatch.StartNew();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, dataClass, operation, "START", 0);
        try
        {
            var result = await action();
            watch.Stop();
            PerformanceDiagnosticsLog.Write(
                _performanceDiagnosticRunId,
                dataClass,
                operation,
                "OK",
                watch.Elapsed.TotalMilliseconds,
                details?.Invoke(result));
            return result;
        }
        catch (Exception exception)
        {
            watch.Stop();
            PerformanceDiagnosticsLog.WriteFailure(
                _performanceDiagnosticRunId,
                dataClass,
                operation,
                watch.Elapsed.TotalMilliseconds,
                exception);
            throw;
        }
    }

    private async Task<IJSObjectReference> ImportPerformanceModuleAsync(
        string operation,
        string path)
    {
        var watch = Stopwatch.StartNew();
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", path);
            watch.Stop();
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "RENDER", operation, "OK", watch.Elapsed.TotalMilliseconds);
            return module;
        }
        catch (Exception exception)
        {
            watch.Stop();
            PerformanceDiagnosticsLog.WriteFailure(_performanceDiagnosticRunId, "RENDER", operation, watch.Elapsed.TotalMilliseconds, exception);
            throw;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        DisplayPrefixes.Changed += HandleDisplayPrefixesChanged;

        TaskCompletionSource<NavigationRefreshResult>? initialNavigationCompletion = null;
        var initializationWatch = Stopwatch.StartNew();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "HOME", "INITIALIZE", "START", 0);
        try
        {
            if (OidcSettings.Enabled)
            {
                var tokenStore =
                    ServiceProvider.GetService<ProtectedUserPaperlessTokenStore>();

                if (tokenStore is null ||
                    !(await tokenStore.GetStatusAsync()).IsConfigured)
                {
                    Navigation.NavigateTo("/", replace: true);
                    return;
                }
            }

            var contextWatch = Stopwatch.StartNew();
            var context = await ClientFactory.CreateContextAsync();
            contextWatch.Stop();
            _paperlessClient = context.Client;
            _paperlessClient.DiagnosticRunId = _performanceDiagnosticRunId;
            _sessionId = context.SessionId;
            _navigationCacheKey = context.CacheKey;
            _paperlessBaseUrl = context.BaseUrl;
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "HOME", "CLIENT_CONTEXT", "OK", contextWatch.Elapsed.TotalMilliseconds);

            var correspondentsTask = MeasurePerformanceAsync(
                "REF", "CORRESPONDENTS_INITIAL", () => context.Client.GetCorrespondentsAsync(), result => $"count={result.Count}");

            var documentTypesTask = MeasurePerformanceAsync(
                "REF", "DOCUMENT_TYPES_INITIAL", () => context.Client.GetDocumentTypesAsync(), result => $"count={result.Count}");

            var tagsTask = MeasurePerformanceAsync(
                "REF", "TAGS_INITIAL", () => context.Client.GetTagsAsync(), result => $"count={result.Count}");

            var customFieldsTask = MeasurePerformanceAsync(
                "REF", "CUSTOM_FIELDS_INITIAL", () => context.Client.GetCustomFieldsAsync(), result => $"count={result.Count}");

            var storagePathsTask = MeasurePerformanceAsync(
                "REF", "STORAGE_PATHS_INITIAL", () => context.Client.GetStoragePathsAsync(), result => $"count={result.Count}");

            var versionTask = MeasurePerformanceAsync(
                "SYS", "PAPERLESS_VERSION", () => SafeGetPaperlessVersionAsync(context.Client), result => $"available={!string.IsNullOrWhiteSpace(result)}");

            var cacheTask =
                NavigationCache.LoadAsync(context.CacheKey, _performanceDiagnosticRunId);

            initialNavigationCompletion =
                new TaskCompletionSource<NavigationRefreshResult>(
                    TaskCreationOptions.RunContinuationsAsynchronously);
            _initialNavigationTask = initialNavigationCompletion.Task;

            var startCriticalWatch = Stopwatch.StartNew();
            await Task.WhenAll(
                storagePathsTask,
                cacheTask);
            startCriticalWatch.Stop();
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "HOME", "START_CRITICAL_TASKS_WHEN_ALL", "OK", startCriticalWatch.Elapsed.TotalMilliseconds);

            ApplyStoragePaths(storagePathsTask.Result);
            var cachedSnapshot = cacheTask.Result;

            if (cachedSnapshot is not null)
            {
                _ = CompleteInitialReferenceDataInBackgroundAsync(
                    correspondentsTask,
                    documentTypesTask,
                    tagsTask,
                    customFieldsTask,
                    versionTask);

                PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "HOME", "CACHE_DECISION", "HIT", 0, $"count={cachedSnapshot.Documents.Count}");
                ApplyNavigationSnapshot(cachedSnapshot);

                _navigationStatus =
                    $"Navigation sofort aus Cache geladen · Stand {FormatLocalTime(cachedSnapshot.BuiltAtUtc)}";

                initialNavigationCompletion.TrySetResult(
                    new NavigationRefreshResult(
                        cachedSnapshot,
                        Rebuilt: false,
                        CheckedAtUtc: DateTimeOffset.UtcNow));

            }
            else
            {
                await ApplyInitialReferenceDataAsync(
                    correspondentsTask,
                    documentTypesTask,
                    tagsTask,
                    customFieldsTask,
                    versionTask);

                PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "HOME", "CACHE_DECISION", "MISS_FULL_REBUILD", 0);
                _navigationStatus =
                    "Navigation wird erstmals aufgebaut …";

                _isRefreshingNavigation = true;

                var buildTask =
                    RunNavigationOperationAsync(
                        forceFullRebuild: true,
                        existingSnapshot: null);

                _ = CompleteInitialNavigationBuildAsync(
                    buildTask,
                    initialNavigationCompletion);
            }

            _centralSyncRegistration = CentralSync.Register(
                context.CacheKey,
                IsSessionAvailable,
                RunCentralNavigationCheckAsync,
                HandleCentralSyncStatusChangedAsync,
                HandleCentralSyncCompletedAsync,
                HandleCentralSyncFailedAsync,
                _performanceDiagnosticRunId);

            if (cachedSnapshot is not null)
            {
                PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "SYNC", "REQUEST_IMMEDIATE", "QUEUED", 0);
                CentralSync.RequestImmediateCheck(context.CacheKey);
            }

            initializationWatch.Stop();
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "HOME", "INITIALIZE", "OK", initializationWatch.Elapsed.TotalMilliseconds, $"cache_present={cachedSnapshot is not null}");
        }
        catch (InvalidOperationException exception)
            when (string.Equals(
                exception.Message,
                "Für den angemeldeten Benutzer ist noch kein persönlicher Paperless-Zugang hinterlegt.",
                StringComparison.Ordinal))
        {
            initialNavigationCompletion?.TrySetException(exception);
            _initialNavigationTask = null;
            initializationWatch.Stop();
            PerformanceDiagnosticsLog.WriteFailure(_performanceDiagnosticRunId, "HOME", "INITIALIZE", initializationWatch.Elapsed.TotalMilliseconds, exception);
            _errorMessage = exception.Message;
            _navigationStatus =
                "Persönliche Paperless-Zuordnung fehlt";
        }
        catch (Exception exception)
        {
            if (exception is OperationCanceledException)
            {
                initialNavigationCompletion?.TrySetCanceled();
            }
            else
            {
                initialNavigationCompletion?.TrySetException(exception);
            }

            _initialNavigationTask = null;
            initializationWatch.Stop();
            PerformanceDiagnosticsLog.WriteFailure(_performanceDiagnosticRunId, "HOME", "INITIALIZE", initializationWatch.Elapsed.TotalMilliseconds, exception);
            var error = PaperlessErrorClassifier.Classify(
                exception,
                fallbackMessage: "Die Stammdaten oder der Navigationscache konnten nicht geladen werden.");

            if (!error.IsControlledCancellation)
            {
                _errorMessage = error.UserMessage;
                _navigationStatus = "Navigation nicht verfügbar";
                LogPaperlessError("Stammdaten und Navigation laden", error);
            }
        }
    }

    private async Task ApplyInitialReferenceDataAsync(
        Task<IReadOnlyList<CorrespondentDto>> correspondentsTask,
        Task<IReadOnlyList<DocumentTypeDto>> documentTypesTask,
        Task<IReadOnlyList<TagDto>> tagsTask,
        Task<IReadOnlyList<CustomFieldDto>> customFieldsTask,
        Task<string?> versionTask)
    {
        var whenAllWatch = Stopwatch.StartNew();
        await Task.WhenAll(
            correspondentsTask,
            documentTypesTask,
            tagsTask,
            customFieldsTask,
            versionTask);
        whenAllWatch.Stop();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "HOME", "INITIAL_TASKS_WHEN_ALL", "OK", whenAllWatch.Elapsed.TotalMilliseconds);

        await InvokeAsync(() =>
        {
            _allCorrespondents = correspondentsTask.Result;
            _allDocumentTypes = documentTypesTask.Result;
            _allTags = tagsTask.Result;
            _allCustomFields = customFieldsTask.Result;
            _paperlessVersion = versionTask.Result;
            _areInitialReferenceDataReady = true;

            if (_selectedArea is not null &&
                _areaCache.TryGetValue(_selectedArea.StoragePathId, out var selectedAreaIndex))
            {
                ApplyAreaIndex(selectedAreaIndex);

                if (_selectedCorrespondent is not null)
                {
                    SetDocumentTypesForCorrespondent(_selectedCorrespondent.Id);
                }
            }

            StateHasChanged();
        });
    }

    private async Task CompleteInitialReferenceDataInBackgroundAsync(
        Task<IReadOnlyList<CorrespondentDto>> correspondentsTask,
        Task<IReadOnlyList<DocumentTypeDto>> documentTypesTask,
        Task<IReadOnlyList<TagDto>> tagsTask,
        Task<IReadOnlyList<CustomFieldDto>> customFieldsTask,
        Task<string?> versionTask)
    {
        try
        {
            await ApplyInitialReferenceDataAsync(
                correspondentsTask,
                documentTypesTask,
                tagsTask,
                customFieldsTask,
                versionTask);
        }
        catch (Exception exception)
        {
            PerformanceDiagnosticsLog.WriteFailure(
                _performanceDiagnosticRunId,
                "HOME",
                "INITIAL_REFERENCE_DATA_BACKGROUND",
                0,
                exception);

            var error = PaperlessErrorClassifier.Classify(
                exception,
                fallbackMessage: "Die Stammdaten konnten im Hintergrund nicht vollständig geladen werden.");

            if (!error.IsControlledCancellation)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = error.UserMessage;
                    StateHasChanged();
                });

                LogPaperlessError("Stammdaten im Hintergrund laden", error);
            }
        }
    }

    private bool IsSessionAvailable()
    {
        return CircuitConnection.IsConnected &&
               (_sessionId is null || UserSessions.IsActive(_sessionId));
    }

    private PaperlessApiClient GetPaperlessClient()
    {
        if (!IsSessionAvailable())
        {
            throw new WebUiSessionUnavailableException();
        }

        return _paperlessClient
            ?? throw new InvalidOperationException(
                "Der benutzergebundene Paperless-Zugriff ist noch nicht initialisiert.");
    }

    private static async Task<string?> SafeGetPaperlessVersionAsync(PaperlessApiClient client)
    {
        try
        {
            var status = await client.GetSystemStatusAsync();
            return string.IsNullOrWhiteSpace(status.PaperlessNgxVersion)
                ? null
                : status.PaperlessNgxVersion.Trim();
        }
        catch
        {
            return null;
        }
    }

    private async Task ReloadNavigationReferenceDataAsync()
    {
        var watch = Stopwatch.StartNew();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "REF", "RELOAD_ALL", "START", 0);
        var client =
            GetPaperlessClient();

        var correspondentsTask =
            client.GetCorrespondentsAsync();

        var documentTypesTask =
            client.GetDocumentTypesAsync();

        var tagsTask =
            client.GetTagsAsync();

        var customFieldsTask =
            client.GetCustomFieldsAsync();

        var storagePathsTask =
            client.GetStoragePathsAsync();

        await Task.WhenAll(
            correspondentsTask,
            documentTypesTask,
            tagsTask,
            customFieldsTask,
            storagePathsTask);
        watch.Stop();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "REF", "RELOAD_ALL", "OK", watch.Elapsed.TotalMilliseconds, $"correspondents={correspondentsTask.Result.Count};document_types={documentTypesTask.Result.Count};tags={tagsTask.Result.Count};custom_fields={customFieldsTask.Result.Count};storage_paths={storagePathsTask.Result.Count}");

        await InvokeAsync(() =>
        {
            _allCorrespondents =
                correspondentsTask.Result;

            _allDocumentTypes =
                documentTypesTask.Result;

            _allTags =
                tagsTask.Result;

            _allCustomFields =
                customFieldsTask.Result;

            ApplyStoragePaths(
                storagePathsTask.Result);
        });
    }

    private async Task<bool> ReloadStoragePathsAsync()
    {
        try
        {
            var client = GetPaperlessClient();
            var storagePaths = await client.GetStoragePathsAsync();
            var structureChanged = false;

            await InvokeAsync(() =>
            {
                var previousIds = _areas
                    .Where(area => area.StoragePathId != UnassignedAreaKey)
                    .Select(area => area.StoragePathId)
                    .OrderBy(id => id)
                    .ToArray();

                var currentIds = storagePaths
                    .Where(item => item.Id > 0)
                    .Select(item => item.Id)
                    .Distinct()
                    .OrderBy(id => id)
                    .ToArray();

                structureChanged = !previousIds.SequenceEqual(currentIds);
                ApplyStoragePaths(storagePaths);
                StateHasChanged();
            });

            return structureChanged;
        }
        catch
        {
            // Ein vorübergehender Fehler beim Laden der Speicherpfade darf
            // die normale Navigationsprüfung nicht dauerhaft beenden.
            return false;
        }
    }

    private bool HasCurrentAreaSet(
        NavigationCacheSnapshot snapshot)
    {
        return snapshot.FormatVersion == 3 &&
            snapshot.SourceStates.ContainsKey(AllAreaKey);
    }

    private async Task SelectAreaAsync(AreaDefinition area)
    {
        ResetDocumentSearchForSelectionChange();
        _selectedArea = area;
        _selectedCorrespondent = null;
        _selectedDocumentType = null;
        _currentIndex = null;
        _areaCorrespondents = [];
        _documentTypes = [];
        _documents = [];
        _localFilter = string.Empty;
        _documentPage = 1;
        _totalCount = 0;
        _errorMessage = null;

        if (_areaCache.TryGetValue(
                area.StoragePathId,
                out var cached))
        {
            _isLoadingArea = false;

            if (_areInitialReferenceDataReady)
            {
                ApplyAreaIndex(cached);
            }
            else
            {
                _currentIndex = cached;
                _progressPercent = 100;
            }

            return;
        }

        _isLoadingArea = true;

        try
        {
            if (_initialNavigationTask is null)
            {
                _initialNavigationTask =
                    RunNavigationOperationAsync(
                        forceFullRebuild: true,
                        existingSnapshot: null);
            }

            var result =
                await _initialNavigationTask;

            ApplyNavigationSnapshot(result.Snapshot);

            if (_selectedArea?.StoragePathId ==
                    area.StoragePathId &&
                _areaCache.TryGetValue(
                    area.StoragePathId,
                    out var index))
            {
                ApplyAreaIndex(index);
            }
        }
        catch (Exception exception)
        {
            var error = PaperlessErrorClassifier.Classify(
                exception,
                fallbackMessage: "Die Korrespondenten dieses Bereichs konnten nicht geladen werden.");

            if (!error.IsControlledCancellation)
            {
                LogPaperlessError("Korrespondenten eines Bereichs laden", error);

                if (_selectedArea?.StoragePathId == area.StoragePathId)
                {
                    _errorMessage = error.UserMessage;
                }
            }
        }
        finally
        {
            if (_selectedArea?.StoragePathId ==
                area.StoragePathId)
            {
                _isLoadingArea = false;
            }
        }
    }

    private async Task<NavigationRefreshResult> RunCentralNavigationCheckAsync(
        NavigationCacheSnapshot cachedSnapshot,
        IProgress<CentralSyncProgress> progress)
    {
        if (!HasCurrentAreaSet(cachedSnapshot))
        {
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "SYNC", "DECISION", "FULL_REBUILD", 0, "reason=current_area_set_missing");
            return await RunNavigationOperationAsync(
                forceFullRebuild: true,
                existingSnapshot: cachedSnapshot);
        }

        var latestKnownModifiedUtc = cachedSnapshot.Documents
            .Where(document => document.ModifiedUtc.HasValue)
            .Select(document => document.ModifiedUtc!.Value)
            .DefaultIfEmpty(cachedSnapshot.BuiltAtUtc)
            .Max();

        var knownDocumentsAtLatestTimestamp = cachedSnapshot.Documents
            .Count(document => document.ModifiedUtc == latestKnownModifiedUtc);

        var client = GetPaperlessClient();

        var documentCheckStartedAt = DateTimeOffset.UtcNow;
        Logger.LogInformation("Dokumenten-Änderungsprüfung gestartet.");
        var hasDocumentChanges = await client.HasNavigationDocumentChangesAsync(
            latestKnownModifiedUtc,
            knownDocumentsAtLatestTimestamp);
        Logger.LogInformation(
            "Dokumenten-Änderungsprüfung beendet. Änderung erkannt: {HasChanges}; DauerMs: {DurationMs}",
            hasDocumentChanges,
            (DateTimeOffset.UtcNow - documentCheckStartedAt).TotalMilliseconds);

        var visibleCountCheckStartedAt = DateTimeOffset.UtcNow;
        Logger.LogInformation("Prüfung der sichtbaren Dokumentanzahl gestartet.");
        var visibleDocumentCount =
            await client.GetVisibleNavigationDocumentCountAsync();
        var visibleDocumentCountChanged =
            visibleDocumentCount != cachedSnapshot.Documents.Count;
        Logger.LogInformation(
            "Prüfung der sichtbaren Dokumentanzahl beendet. Cache: {CachedCount}; Aktuell: {VisibleCount}; Änderung erkannt: {HasChanges}; DauerMs: {DurationMs}",
            cachedSnapshot.Documents.Count,
            visibleDocumentCount,
            visibleDocumentCountChanged,
            (DateTimeOffset.UtcNow - visibleCountCheckStartedAt).TotalMilliseconds);

        var trashChanged = false;
        var nowUtc = DateTimeOffset.UtcNow;

        if (nowUtc >= _nextTrashCheckUtc)
        {
            var trashCheckStartedAt = DateTimeOffset.UtcNow;
            Logger.LogInformation("Papierkorbprüfung gestartet.");
            var currentTrashDocumentIds = await client.GetTrashDocumentIdsAsync();
            Logger.LogInformation(
                "Papierkorbprüfung beendet. Anzahl technischer IDs: {TrashIdCount}; DauerMs: {DurationMs}",
                currentTrashDocumentIds.Count,
                (DateTimeOffset.UtcNow - trashCheckStartedAt).TotalMilliseconds);
            var cachedDocumentIds = cachedSnapshot.Documents
                .Select(document => document.Id)
                .ToHashSet();

            trashChanged =
                currentTrashDocumentIds.Any(cachedDocumentIds.Contains) ||
                !_knownTrashDocumentIds.SetEquals(currentTrashDocumentIds);

            _knownTrashDocumentIds = currentTrashDocumentIds;
            _nextTrashCheckUtc = nowUtc.Add(TrashCheckInterval);
        }

        if (!hasDocumentChanges &&
            !visibleDocumentCountChanged &&
            !trashChanged)
        {
            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "SYNC", "DECISION", "CACHE_KEEP", 0, $"cached={cachedSnapshot.Documents.Count};visible={visibleDocumentCount}");
            return new NavigationRefreshResult(
                cachedSnapshot,
                Rebuilt: false,
                CheckedAtUtc: DateTimeOffset.UtcNow);
        }

        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "SYNC", "DECISION", "RECONCILE", 0, $"document_changes={hasDocumentChanges};visible_count_changed={visibleDocumentCountChanged};trash_changed={trashChanged};cached={cachedSnapshot.Documents.Count};visible={visibleDocumentCount}");

        await InvokeAsync(() =>
        {
            _navigationStatus = trashChanged
                ? "Änderung im Papierkorb erkannt · Navigation wird abgeglichen …"
                : visibleDocumentCountChanged
                    ? "Geänderte Dokumentrechte erkannt · Navigation wird abgeglichen …"
                    : "Dokumentänderung erkannt · Navigation wird gezielt aktualisiert …";
            StateHasChanged();
        });

        return await RunNavigationOperationAsync(
            forceFullRebuild: false,
            existingSnapshot: cachedSnapshot,
            centralProgress: progress);
    }

    private Task HandleCentralSyncStatusChangedAsync(CentralSyncStatus status)
    {
        return InvokeAsync(() =>
        {
            _isRefreshingNavigation = status.IsRunning;

            if (!status.IsRunning)
            {
                StopSyncStatusUpdates();
                _syncStartedAt = null;
                StateHasChanged();
                return;
            }

            _syncStartedAt = status.StartedAtUtc ?? DateTimeOffset.UtcNow;
            _syncElapsedSeconds = Math.Max(
                0,
                (int)(DateTimeOffset.UtcNow - _syncStartedAt.Value).TotalSeconds);
            _progressPercent = status.Percent;
            _loadedDocuments = status.LoadedDocuments;
            _totalDocumentsToLoad = status.TotalDocuments;
            _navigationStatus = status.StatusText;
            StartSyncStatusUpdates();
            StateHasChanged();
        });
    }

    private async Task HandleCentralSyncCompletedAsync(
        NavigationRefreshResult result,
        bool isFullRefresh)
    {
        var callbackWatch = Stopwatch.StartNew();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "SYNC", "COMPLETED_CALLBACK", "START", 0, $"rebuilt={result.Rebuilt};full_refresh={isFullRefresh};count={result.Snapshot.Documents.Count}");
        if (result.Rebuilt || isFullRefresh)
        {
            await ReloadNavigationReferenceDataAsync();
        }

        await InvokeAsync(() =>
        {
            ApplyNavigationSnapshot(result.Snapshot);

            var durationText = FormatSyncDuration();
            _navigationStatus = BuildCompletedNavigationStatus(
                isFullRefresh
                    ? "Navigation vollständig aktualisiert"
                    : result.Rebuilt
                        ? "Änderungen übernommen"
                        : "Navigation ist aktuell",
                result.Snapshot.Documents.Count,
                durationText,
                result.CheckedAtUtc);

            _isRefreshingNavigation = false;
            StopSyncStatusUpdates();
            _syncStartedAt = null;
            StateHasChanged();
        });

        if ((result.Rebuilt || isFullRefresh) && _selectedDocumentType is not null)
        {
            await InvokeAsync(async () =>
            {
                _documentPage = 1;
                await LoadAllDocumentsForCurrentSelectionAsync();
                StateHasChanged();
            });
        }

        callbackWatch.Stop();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "SYNC", "COMPLETED_CALLBACK", "OK", callbackWatch.Elapsed.TotalMilliseconds, $"rebuilt={result.Rebuilt};full_refresh={isFullRefresh};count={result.Snapshot.Documents.Count}");
    }

    private Task HandleCentralSyncFailedAsync(CentralSyncFailure failure)
    {
        return InvokeAsync(() =>
        {
            _navigationStatus = failure.IsFullRefresh
                ? "Vollständige Aktualisierung fehlgeschlagen · vorhandener Cache bleibt nutzbar"
                : "Zentrale Hintergrundprüfung fehlgeschlagen · vorhandener Cache bleibt nutzbar";

            if (failure.IsFullRefresh)
            {
                _errorMessage = failure.Error.UserMessage;
            }

            _isRefreshingNavigation = false;
            StopSyncStatusUpdates();
            _syncStartedAt = null;
            StateHasChanged();
        });
    }

    private async Task CompleteInitialNavigationBuildAsync(
        Task<NavigationRefreshResult> buildTask,
        TaskCompletionSource<NavigationRefreshResult> initialNavigationCompletion)
    {
        try
        {
            var result = await buildTask;
            initialNavigationCompletion.TrySetResult(result);

            if (result.Rebuilt)
            {
                await ReloadNavigationReferenceDataAsync();
            }

            await InvokeAsync(() =>
            {
                ApplyNavigationSnapshot(result.Snapshot);

                _navigationStatus =
                    $"Navigation aufgebaut · {result.Snapshot.Documents.Count:N0} Dokumente · {FormatLocalTime(result.CheckedAtUtc)}";

                _isRefreshingNavigation = false;
                StopSyncStatusUpdates();
                _syncStartedAt = null;
                StateHasChanged();
            });
        }
        catch (Exception exception)
        {
            if (exception is OperationCanceledException)
            {
                initialNavigationCompletion.TrySetCanceled();
            }
            else
            {
                initialNavigationCompletion.TrySetException(exception);
            }

            var isLocalCacheError =
                exception is IOException or UnauthorizedAccessException;

            var error = isLocalCacheError
                ? new PaperlessErrorInfo(
                    $"PLS-{Guid.NewGuid():N}"[..16].ToUpperInvariant(),
                    "Lokaler Cachefehler",
                    null,
                    "Der lokale Navigationscache konnte nicht gespeichert werden.",
                    exception.GetType().Name,
                    IsTimeout: false,
                    IsControlledCancellation: false)
                : PaperlessErrorClassifier.Classify(
                    exception,
                    CancellationToken.None,
                    fallbackMessage: "Die Navigation konnte nicht aufgebaut werden.");

            LogPaperlessError("Ersten Navigationsaufbau abschließen", error);

            await InvokeAsync(() =>
            {
                _initialNavigationTask = null;
                _isRefreshingNavigation = false;
                _navigationStatus = "Erster Navigationsaufbau fehlgeschlagen";
                _errorMessage = error.UserMessage;
                StateHasChanged();
            });
        }
    }

    private async Task RefreshNavigationAsync()
    {
        if (_isRefreshingNavigation ||
            _navigationCacheKey is null)
        {
            return;
        }

        _errorMessage = null;

        await CentralSync.RequestFullRefreshAsync(
            _navigationCacheKey,
            IsSessionAvailable,
            RunCentralFullRefreshAsync);
    }

    private async Task<NavigationRefreshResult> RunCentralFullRefreshAsync(
        IProgress<CentralSyncProgress> progress)
    {
        await ReloadStoragePathsAsync();

        var refreshTask = RunNavigationOperationAsync(
            forceFullRebuild: true,
            existingSnapshot: _navigationSnapshot,
            centralProgress: progress);

        _initialNavigationTask = refreshTask;
        return await refreshTask;
    }

    private Task<NavigationRefreshResult>
        RunNavigationOperationAsync(
            bool forceFullRebuild,
            NavigationCacheSnapshot? existingSnapshot,
            IProgress<CentralSyncProgress>? centralProgress = null)
    {
        if (_navigationCacheKey is null)
        {
            throw new InvalidOperationException(
                "Der benutzerbezogene Cacheschlüssel fehlt.");
        }

        var cacheKey = _navigationCacheKey;
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "OPERATION", "START", 0, $"force_full={forceFullRebuild};existing={existingSnapshot is not null};existing_count={existingSnapshot?.Documents.Count ?? 0}");

        return NavigationCache.RunSingleOperationAsync(
            cacheKey,
            async () =>
            {
                var client =
                    GetPaperlessClient();

                if (!forceFullRebuild &&
                    existingSnapshot is not null)
                {
                    var currentState =
                        await client.GetNavigationSourceStateAsync();

                    if (existingSnapshot.Matches(
                            currentState))
                    {
                        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "DECISION", "CACHE_KEEP", 0, "reason=source_state_matches");
                        return new NavigationRefreshResult(
                            existingSnapshot,
                            Rebuilt: false,
                            CheckedAtUtc:
                                DateTimeOffset.UtcNow);
                    }

                    await InvokeAsync(() =>
                    {
                        _navigationStatus =
                            "Änderungen gefunden · betroffene Zuordnungen werden übernommen …";
                        StateHasChanged();
                    });

                    var currentTotal = currentState.Values.Sum(state => state.DocumentCount);
                    var cachedTotal = existingSnapshot.Documents.Count;

                    if (currentTotal >= cachedTotal)
                    {
                        var changedDocuments =
                            await client.GetNavigationDocumentsModifiedSinceAsync(
                                existingSnapshot.BuiltAtUtc.AddMinutes(-15));

                        var incrementalSnapshot = existingSnapshot.ApplyChanges(
                            changedDocuments);

                        // Die Statuswerte der API sind maßgeblich. Dadurch führt eine
                        // reine Umbenennung eines Speicherpfads nicht zu wiederholten
                        // Sicherheitsprüfungen wegen Zeitstempelabweichungen.
                        incrementalSnapshot.SourceStates =
                            currentState.ToDictionary(pair => pair.Key, pair => pair.Value);

                        if (incrementalSnapshot.Documents.Count == currentTotal &&
                            incrementalSnapshot.Matches(currentState))
                        {
                            PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "DECISION", "INCREMENTAL_APPLY", 0, $"changed={changedDocuments.Count};count={incrementalSnapshot.Documents.Count}");
                            await NavigationCache.SaveAsync(cacheKey, incrementalSnapshot, _performanceDiagnosticRunId);
                            return new NavigationRefreshResult(
                                incrementalSnapshot,
                                Rebuilt: true,
                                CheckedAtUtc: DateTimeOffset.UtcNow);
                        }
                    }

                    PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "DECISION", "FULL_REBUILD", 0, "reason=incremental_not_authoritative");
                    await InvokeAsync(() =>
                    {
                        _navigationStatus =
                            "Abweichung nicht eindeutig · vollständige Sicherheitsprüfung läuft …";
                        StateHasChanged();
                    });
                }

                var progress =
                    new Progress<AreaNavigationProgress>(
                        value =>
                        {
                            _progressPercent =
                                value.Percent;

                            _loadedDocuments =
                                value.LoadedDocuments;

                            _totalDocumentsToLoad =
                                value.TotalDocuments;

                            _navigationStatus =
                                $"Navigation wird aktualisiert · {value.Percent}%";

                            centralProgress?.Report(new CentralSyncProgress(
                                value.Percent,
                                value.LoadedDocuments,
                                value.TotalDocuments,
                                _navigationStatus));

                            _ = InvokeAsync(
                                StateHasChanged);
                        });

                var storagePathIds =
                    _areas
                        .Select(area =>
                            area.StoragePathId)
                        .ToArray();

                if (forceFullRebuild)
                {
                    PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "DECISION", "FULL_REBUILD", 0, "reason=forced");
                    var documents =
                        await client.GetNavigationDocumentsAsync(
                            progress);

                    var snapshotWatch = Stopwatch.StartNew();
                    var snapshot =
                        NavigationCacheSnapshot.Create(
                            documents);
                    snapshotWatch.Stop();
                    PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "SNAPSHOT_CREATE", "OK", snapshotWatch.Elapsed.TotalMilliseconds, $"mode=forced;count={snapshot.Documents.Count}");

                    // Die bewusst manuell ausgelöste Vollprüfung bleibt unverändert:
                    // ein vollständiger Aufbau, anschließend aktueller API-Status
                    // und direkte Speicherung ohne Vorher-nachher-Vergleich.
                    var authoritativeState =
                        await client.GetNavigationSourceStateAsync();
                    snapshot.SourceStates =
                        authoritativeState.ToDictionary(
                            pair => pair.Key,
                            pair => pair.Value);

                    await InvokeAsync(() =>
                    {
                        _navigationStatus =
                            "Navigation wird gespeichert …";
                        StateHasChanged();
                    });

                    await NavigationCache.SaveAsync(
                        cacheKey,
                        snapshot,
                        _performanceDiagnosticRunId);

                    return new NavigationRefreshResult(
                        snapshot,
                        Rebuilt: true,
                        CheckedAtUtc:
                            DateTimeOffset.UtcNow);
                }

                const int maximumAutomaticBuildAttempts = 2;

                for (var attempt = 1;
                     attempt <= maximumAutomaticBuildAttempts;
                     attempt++)
                {
                    var stateBeforeBuild =
                        await client.GetNavigationSourceStateAsync();

                    var documents =
                        await client.GetNavigationDocumentsAsync(
                            progress);

                    var snapshotWatch = Stopwatch.StartNew();
                    var snapshot =
                        NavigationCacheSnapshot.Create(
                            documents);
                    snapshotWatch.Stop();
                    PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "SNAPSHOT_CREATE", "OK", snapshotWatch.Elapsed.TotalMilliseconds, $"mode=automatic;attempt={attempt};count={snapshot.Documents.Count}");

                    var stateAfterBuild =
                        await client.GetNavigationSourceStateAsync();

                    snapshot.SourceStates =
                        stateBeforeBuild.ToDictionary(
                            pair => pair.Key,
                            pair => pair.Value);

                    if (snapshot.Matches(stateAfterBuild))
                    {
                        snapshot.SourceStates =
                            stateAfterBuild.ToDictionary(
                                pair => pair.Key,
                                pair => pair.Value);

                        await InvokeAsync(() =>
                        {
                            _navigationStatus =
                                "Navigation wird gespeichert …";
                            StateHasChanged();
                        });

                        await NavigationCache.SaveAsync(
                            cacheKey,
                            snapshot,
                            _performanceDiagnosticRunId);

                        return new NavigationRefreshResult(
                            snapshot,
                            Rebuilt: true,
                            CheckedAtUtc:
                                DateTimeOffset.UtcNow);
                    }

                    if (attempt <
                        maximumAutomaticBuildAttempts)
                    {
                        await InvokeAsync(() =>
                        {
                            _navigationStatus =
                                "Bestand während des Aufbaus geändert · einmaliger Neuversuch läuft …";
                            StateHasChanged();
                        });
                    }
                }

                if (existingSnapshot is not null)
                {
                    await InvokeAsync(() =>
                    {
                        _navigationStatus =
                            "Bestand erneut geändert · bisheriger Navigationscache bleibt erhalten";
                        StateHasChanged();
                    });

                    return new NavigationRefreshResult(
                        existingSnapshot,
                        Rebuilt: false,
                        CheckedAtUtc:
                            DateTimeOffset.UtcNow);
                }

                throw new InvalidOperationException(
                    "Der Dokumentbestand hat sich während beider automatischen Cacheaufbauten geändert.");
            });
    }

    private void ApplyNavigationSnapshot(
        NavigationCacheSnapshot snapshot)
    {
        var overall = Stopwatch.StartNew();
        _navigationSnapshot = snapshot;
        var areasWatch = Stopwatch.StartNew();
        RebuildAreasForSnapshot(snapshot);
        areasWatch.Stop();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "REBUILD_AREAS", "OK", areasWatch.Elapsed.TotalMilliseconds, $"count={snapshot.Documents.Count}");

        var selectedCorrespondentId =
            _selectedCorrespondent?.Id;

        var selectedDocumentTypeId =
            _selectedDocumentType?.Id;

        var indexesWatch = Stopwatch.StartNew();
        var indexes = snapshot.BuildIndexes(
            _areas.Select(area =>
                area.StoragePathId));
        indexesWatch.Stop();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "BUILD_INDEXES", "OK", indexesWatch.Elapsed.TotalMilliseconds, $"count={snapshot.Documents.Count};areas={indexes.Count}");

        _areaCache.Clear();

        foreach (var pair in indexes)
        {
            _areaCache[pair.Key] = pair.Value;
        }
        overall.Stop();
        PerformanceDiagnosticsLog.Write(_performanceDiagnosticRunId, "NAV", "APPLY_SNAPSHOT", "OK", overall.Elapsed.TotalMilliseconds, $"count={snapshot.Documents.Count};areas={indexes.Count}");

        if (_selectedArea is null ||
            !_areaCache.TryGetValue(
                _selectedArea.StoragePathId,
                out var selectedAreaIndex))
        {
            return;
        }

        ApplyAreaIndex(selectedAreaIndex);

        if (!selectedCorrespondentId.HasValue)
        {
            return;
        }

        var preservedCorrespondent =
            _areaCorrespondents.FirstOrDefault(
                item =>
                    item.Id ==
                    selectedCorrespondentId.Value);

        if (preservedCorrespondent is null)
        {
            _selectedCorrespondent = null;
            _selectedDocumentType = null;
            _documentTypes = [];
            _documents = [];
            _totalCount = 0;
            return;
        }

        _selectedCorrespondent =
            preservedCorrespondent;

        SetDocumentTypesForCorrespondent(
            preservedCorrespondent.Id);

        if (!selectedDocumentTypeId.HasValue)
        {
            return;
        }

        var preservedDocumentType =
            _documentTypes.FirstOrDefault(
                item =>
                    item.Id ==
                    selectedDocumentTypeId.Value);

        if (preservedDocumentType is null)
        {
            _selectedDocumentType = null;
            _documents = [];
            _totalCount = 0;
            return;
        }

        _selectedDocumentType =
            preservedDocumentType;
    }

    private void ApplyAreaIndex(AreaNavigationIndexDto index)
    {
        _currentIndex = index;
        _progressPercent = 100;

        var readableIds = _allCorrespondents.Select(item => item.Id).ToHashSet();
        var hasPrivate = index.CorrespondentIds.Any(id => !readableIds.Contains(id));

        _areaCorrespondents =
        [
            AllCorrespondents,
            UnassignedCorrespondent,
            .. (hasPrivate ? new[] { PrivateCorrespondent } : Array.Empty<CorrespondentDto>()),
            .. _allCorrespondents
                .Where(item => index.CorrespondentIds.Contains(item.Id))
                .OrderBy(item => DisplayCorrespondentName(item.Name))
        ];
    }

    private void SelectCorrespondent(
        CorrespondentDto correspondent)
    {
        ResetDocumentSearchForSelectionChange();
        _selectedCorrespondent = correspondent;
        _selectedDocumentType = null;
        _documents = [];
        _documentPage = 1;
        _totalCount = 0;

        SetDocumentTypesForCorrespondent(
            correspondent.Id);
    }

    private void SetDocumentTypesForCorrespondent(int correspondentId)
    {
        if (_currentIndex is null)
        {
            _documentTypes = [];
            return;
        }

        IReadOnlySet<int> typeIds;
        var hasUnassignedType = false;

        if (correspondentId == AllSelectionId)
        {
            typeIds = _currentIndex.AllDocumentTypeIds;
            hasUnassignedType = _currentIndex.HasAnyUnassignedDocumentType;
        }
        else if (correspondentId == UnassignedSelectionId)
        {
            typeIds = _currentIndex.DocumentTypeIdsForUnassignedCorrespondent;
            hasUnassignedType = _currentIndex.HasUnassignedDocumentTypeForUnassignedCorrespondent;
        }
        else if (correspondentId == PrivateSelectionId)
        {
            var readableIds = _allCorrespondents.Select(item => item.Id).ToHashSet();
            var collected = new HashSet<int>();
            foreach (var id in _currentIndex.CorrespondentIds.Where(id => !readableIds.Contains(id)))
            {
                if (_currentIndex.DocumentTypeIdsByCorrespondent.TryGetValue(id, out var ids))
                    collected.UnionWith(ids);
                if (_currentIndex.CorrespondentIdsWithUnassignedDocumentType.Contains(id))
                    hasUnassignedType = true;
            }
            typeIds = collected;
        }
        else
        {
            typeIds = _currentIndex.DocumentTypeIdsByCorrespondent.TryGetValue(correspondentId, out var ids)
                ? ids
                : new HashSet<int>();
            hasUnassignedType = _currentIndex.CorrespondentIdsWithUnassignedDocumentType.Contains(correspondentId);
        }

        var readableTypeIds = _allDocumentTypes.Select(item => item.Id).ToHashSet();
        var hasPrivate = typeIds.Any(id => !readableTypeIds.Contains(id));

        _documentTypes =
        [
            AllDocumentTypes,
            UnassignedDocumentType,
            .. (hasPrivate ? new[] { PrivateDocumentType } : Array.Empty<DocumentTypeDto>()),
            .. _allDocumentTypes
                .Where(item => typeIds.Contains(item.Id))
                .OrderBy(item => DisplayDocumentTypeName(item.Name))
        ];
    }

    private void ResetDocumentSearchForSelectionChange()
    {
        _documentFilter = string.Empty;
        _documentSearchVersion++;
        _hybridDocumentSearchCancellation?.Cancel();
        _hybridDocumentSearchCancellation?.Dispose();
        _hybridDocumentSearchCancellation = null;
        _activeDocumentSearchResults = [];
        _isSearchingDocuments = false;
    }

    private async Task LoadDocumentsAsync(DocumentTypeDto documentType)
    {
        ResetDocumentSearchForSelectionChange();
        _selectedDocumentType = documentType;
        _documentPage = 1;
        _documents = [];
        _allDocumentsForCurrentSelection = [];
        _documentsById = new Dictionary<int, DocumentListItemDto>();
        ClearDocumentDetails();
        _totalCount = 0;
        _hasMoreDocuments = false;

        await LoadAllDocumentsForCurrentSelectionAsync();
    }

    [JSInvokable]
    public async Task LoadMoreDocumentsFromScrollAsync()
    {
        if (_isLoadingDocuments || _isLoadingMoreDocuments || !_hasMoreDocuments)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_documentFilter))
        {
            var nextCount = Math.Min(
                _documents.Count + DocumentsPerBatch,
                _activeDocumentSearchResults.Count);
            _documents = _activeDocumentSearchResults.Take(nextCount).ToArray();
            _hasMoreDocuments = _documents.Count < _totalCount;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadMorePreparingDocumentsAsync();
    }

    private async Task LoadAllDocumentsForCurrentSelectionAsync()
    {
        if (_selectedArea is null ||
            _selectedCorrespondent is null ||
            _selectedDocumentType is null)
        {
            return;
        }

        var requestSearchVersion = ++_documentSearchVersion;
        var selectedDocumentIdBeforeReload = _selectedDocument?.Id;
        var documentPageBeforeReload = Math.Max(1, _documentPage);
        _isLoadingDocuments = true;
        _errorMessage = null;

        try
        {
            var client = GetPaperlessClient();

            // Zuerst nur ein kleines Paket laden, damit die Dokumentliste sofort benutzbar ist.
            var firstPage = await client.GetDocumentsAsync(
                page: 1,
                pageSize: DocumentsPerBatch,
                storagePathId: _selectedArea.StoragePathId > 0
                    ? _selectedArea.StoragePathId
                    : null,
                storagePathIds: GetSelectedPrivateStoragePathIds(),
                storagePathIsNull: _selectedArea.StoragePathId == UnassignedAreaKey,
                correspondentId: _selectedCorrespondent.Id > 0
                    ? _selectedCorrespondent.Id
                    : null,
                correspondentIds: GetSelectedPrivateCorrespondentIds(),
                correspondentIsNull: _selectedCorrespondent.Id == UnassignedSelectionId,
                documentTypeId: _selectedDocumentType.Id > 0
                    ? _selectedDocumentType.Id
                    : null,
                documentTypeIds: GetSelectedPrivateDocumentTypeIds(),
                documentTypeIsNull: _selectedDocumentType.Id == UnassignedSelectionId,
                sortAscending: _documentsAscending);

            if (requestSearchVersion != _documentSearchVersion)
            {
                return;
            }

            _allDocumentsForCurrentSelection = firstPage.Results.ToArray();
            _documentsById = firstPage.Results.ToDictionary(document => document.Id);
            _documents = firstPage.Results.ToArray();
            _totalCount = firstPage.Count;
            _normalDocumentTotalCount = firstPage.Count;
            _normalDocumentsAscending = _documentsAscending;
            _activeDocumentSearchResults = [];
            _hasMoreDocuments = _documents.Count < _totalCount;
            _documentPage = 1;
                _isLoadingDocuments = false;

            await InvokeAsync(StateHasChanged);

            // v9.70.2B: Kein vollständiger Titelbestand wird mehr im Hintergrund geladen.
            // Die bereits sichtbaren Seiten bleiben lokal durchsuchbar. Bei einer
            // unvollständigen Auswahl übernimmt die lesende Paperless-API die Suche.
            _documentPage = 1;

            await ReconcileSelectedDocumentAfterReloadAsync(
                selectedDocumentIdBeforeReload,
                requestSearchVersion);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            var error = PaperlessErrorClassifier.Classify(
                exception,
                fallbackMessage: "Die Dokumente konnten nicht geladen werden.");

            if (!error.IsControlledCancellation)
            {
                LogPaperlessError(
                    "Dokumente laden",
                    error,
                    cacheContinues: _documents.Count > 0);

                if (_documents.Count == 0)
                {
                    _allDocumentsForCurrentSelection = [];
                    _documentsById = new Dictionary<int, DocumentListItemDto>();
                    _documents = [];
                    _totalCount = 0;
                    _hasMoreDocuments = false;
                    _errorMessage = error.UserMessage;
                }
            }
        }
        finally
        {
            _isLoadingDocuments = false;
            _isLoadingMoreDocuments = false;
        }
    }

    [JSInvokable]
    public async Task LoadMorePreparingDocumentsAsync()
    {
        if (_isLoadingMoreDocuments ||
            _selectedArea is null ||
            _selectedCorrespondent is null ||
            _selectedDocumentType is null ||
            !string.IsNullOrWhiteSpace(_documentFilter) ||
            _allDocumentsForCurrentSelection.Count >= _normalDocumentTotalCount)
        {
            return;
        }

        _isLoadingMoreDocuments = true;
        var requestSearchVersion = _documentSearchVersion;
        var nextPage = (_allDocumentsForCurrentSelection.Count / DocumentsPerBatch) + 1;

        try
        {
            var client = GetPaperlessClient();
            var page = await client.GetDocumentsAsync(
                page: nextPage,
                pageSize: DocumentsPerBatch,
                storagePathId: _selectedArea.StoragePathId > 0
                    ? _selectedArea.StoragePathId
                    : null,
                storagePathIds: GetSelectedPrivateStoragePathIds(),
                storagePathIsNull: _selectedArea.StoragePathId == UnassignedAreaKey,
                correspondentId: _selectedCorrespondent.Id > 0
                    ? _selectedCorrespondent.Id
                    : null,
                correspondentIds: GetSelectedPrivateCorrespondentIds(),
                correspondentIsNull: _selectedCorrespondent.Id == UnassignedSelectionId,
                documentTypeId: _selectedDocumentType.Id > 0
                    ? _selectedDocumentType.Id
                    : null,
                documentTypeIds: GetSelectedPrivateDocumentTypeIds(),
                documentTypeIsNull: _selectedDocumentType.Id == UnassignedSelectionId,
                sortAscending: _documentsAscending);

            if (requestSearchVersion != _documentSearchVersion)
            {
                return;
            }

            var additions = page.Results
                .Where(document => !_documentsById.ContainsKey(document.Id))
                .ToArray();

            if (additions.Length == 0)
            {
                return;
            }

            foreach (var document in additions)
            {
                _documentsById[document.Id] = document;
            }

            _documents = [.. _documents, .. additions];
            _allDocumentsForCurrentSelection = [.. _allDocumentsForCurrentSelection, .. additions];
            _totalCount = _normalDocumentTotalCount;
            _hasMoreDocuments =
                _allDocumentsForCurrentSelection.Count < _normalDocumentTotalCount;

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _isLoadingMoreDocuments = false;
        }
    }

