    }

    private async Task HandleAreaKeyDownAsync(KeyboardEventArgs args)
    {
        if (IsSpaceKey(args))
        {
            if (_areasCollapsed) ExpandAreas();
            else CollapseAreas();
            return;
        }

        if (await HandleListNavigationAsync(args, SortedAreas, _selectedArea,
                area => area.StoragePathId, SelectAreaAsync, AreaElementId, "area", "correspondent")) return;
        await HandleTypeAheadAsync(args, SortedAreas, area => DisplayAreaName(area.DisplayName), SelectAreaAsync, AreaElementId);
    }

    private async Task HandleCorrespondentKeyDownAsync(KeyboardEventArgs args)
    {
        if (IsSpaceKey(args))
        {
            if (_correspondentsCollapsed) ExpandCorrespondents();
            else CollapseCorrespondents();
            return;
        }

        if (await HandleListNavigationAsync(args, FilteredCorrespondents, _selectedCorrespondent,
                item => item.Id, item => { SelectCorrespondent(item); return Task.CompletedTask; }, CorrespondentElementId,
                "correspondent", "document-type")) return;
        await HandleTypeAheadAsync(args, FilteredCorrespondents.Where(item => item.Id > 0).ToArray(),
            item => DisplayCorrespondentName(item.Name), item => { SelectCorrespondent(item); return Task.CompletedTask; }, CorrespondentElementId);
    }

    private async Task HandleDocumentTypeKeyDownAsync(KeyboardEventArgs args)
    {
        if (IsSpaceKey(args))
        {
            if (_documentTypesCollapsed) ExpandDocumentTypes();
            else CollapseDocumentTypes();
            return;
        }

        if (await HandleListNavigationAsync(args, FilteredDocumentTypes, _selectedDocumentType,
                item => item.Id, LoadDocumentsAsync, DocumentTypeElementId, "document-type", "document")) return;
        await HandleTypeAheadAsync(args, FilteredDocumentTypes.Where(item => item.Id > 0).ToArray(),
            item => DisplayDocumentTypeName(item.Name), LoadDocumentsAsync, DocumentTypeElementId);
    }

    private static bool IsSpaceKey(KeyboardEventArgs args)
        => args.Key == " " || args.Key == "Spacebar" || args.Code == "Space";

    private async Task HandleDocumentKeyDownAsync(KeyboardEventArgs args)
    {
        if (IsSpaceKey(args) && _selectedDocument is not null)
        {
            ToggleDocumentInspector();
            return;
        }
        if (args.Key == "ArrowLeft" && _listNavigationModule is not null)
        {
            await _listNavigationModule.InvokeVoidAsync("focusAdjacentColumn", "document", -1);
            return;
        }
        if (_documents.Count == 0) return;
        var index = _selectedDocument is null ? -1 : _documents.ToList().FindIndex(d => d.Id == _selectedDocument.Id);
        if (args.Key == "ArrowDown") index = Math.Min(_documents.Count - 1, index + 1);
        else if (args.Key == "ArrowUp") index = Math.Max(0, index < 0 ? 0 : index - 1);
        else if (args.Key == "Home") index = 0;
        else if (args.Key == "End") index = _documents.Count - 1;
        else return;
        await SelectDocumentAsync(_documents[index]);
        if (_listNavigationModule is not null) await _listNavigationModule.InvokeVoidAsync("scrollTo", DocumentElementId(_documents[index]));
    }

    private async Task<bool> HandleListNavigationAsync<T>(KeyboardEventArgs args, IReadOnlyList<T> items, T? selected,
        Func<T, int> id, Func<T, Task> select, Func<T, string> elementId, string currentColumn, string nextColumn) where T : class
    {
        if (args.Key == "ArrowRight" && _listNavigationModule is not null)
        {
            await _listNavigationModule.InvokeVoidAsync("focusAdjacentColumn", currentColumn, 1); return true;
        }
        if (args.Key == "ArrowLeft" && _listNavigationModule is not null)
        {
            await _listNavigationModule.InvokeVoidAsync("focusAdjacentColumn", currentColumn, -1); return true;
        }
        if (items.Count == 0) return false;
        var index = selected is null ? -1 : items.ToList().FindIndex(x => id(x) == id(selected));
        if (args.Key == "ArrowDown") index = Math.Min(items.Count - 1, index + 1);
        else if (args.Key == "ArrowUp") index = Math.Max(0, index < 0 ? 0 : index - 1);
        else if (args.Key == "Home") index = 0;
        else if (args.Key == "End") index = items.Count - 1;
        else return false;
        await select(items[index]);
        if (_listNavigationModule is not null) await _listNavigationModule.InvokeVoidAsync("scrollTo", elementId(items[index]));
        return true;
    }

    private async Task HandleTypeAheadAsync<T>(
        KeyboardEventArgs args,
        IReadOnlyList<T> items,
        Func<T, string> displayName,
        Func<T, Task> select,
        Func<T, string> elementId)
    {
        if (args.CtrlKey || args.MetaKey || args.AltKey ||
            string.IsNullOrEmpty(args.Key) || args.Key.Length != 1 ||
            char.IsControl(args.Key[0]))
            return;

        var now = DateTimeOffset.UtcNow;
        _typeAheadBuffer = now - _lastTypeAheadInput > TypeAheadTimeout
            ? args.Key
            : _typeAheadBuffer + args.Key;
        _lastTypeAheadInput = now;

        var match = items.FirstOrDefault(item =>
            displayName(item).StartsWith(
                _typeAheadBuffer,
                StringComparison.CurrentCultureIgnoreCase));

        if (match is null)
            return;

        await select(match);
        if (_listNavigationModule is not null)
        {
            await _listNavigationModule.InvokeVoidAsync("scrollTo", elementId(match));
        }
    }

