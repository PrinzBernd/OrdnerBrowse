    private int GetCorrespondentRowCount(CorrespondentDto correspondent)
    {
        var documents = DocumentsForSelectedArea();
        return correspondent.Id switch
        {
            AllSelectionId => documents.Count(),
            UnassignedSelectionId => documents.Count(document => !document.CorrespondentId.HasValue),
            PrivateSelectionId => documents.Count(document => document.CorrespondentId.HasValue &&
                !_allCorrespondents.Any(item => item.Id == document.CorrespondentId.Value)),
            _ => documents
                .Where(document => document.CorrespondentId == correspondent.Id && document.DocumentTypeId.HasValue)
                .Select(document => document.DocumentTypeId!.Value)
                .Distinct()
                .Count()
        };
    }

    private string FormatCorrespondentCount(CorrespondentDto correspondent)
    {
        var count = GetCorrespondentRowCount(correspondent);
        return correspondent.Id > 0
            ? $"{count:N0} {(count == 1 ? "Dokumenttyp" : "Dokumenttypen")}"
            : FormatDocumentCount(count);
    }

    private static string FormatCorrespondentNumber(int count)
        => $"{count:N0} {(count == 1 ? "Korrespondent" : "Korrespondenten")}";

    private static string FormatDocumentCount(int count)
        => $"{count:N0} {(count == 1 ? "Dokument" : "Dokumente")}";

    private int GetDocumentTypeDocumentCount(DocumentTypeDto documentType)
    {
        var documents = DocumentsForSelectedArea();
        if (_selectedCorrespondent is not null)
        {
            documents = _selectedCorrespondent.Id switch
            {
                AllSelectionId => documents,
                UnassignedSelectionId => documents.Where(document => !document.CorrespondentId.HasValue),
                PrivateSelectionId => documents.Where(document => document.CorrespondentId.HasValue &&
                    !_allCorrespondents.Any(item => item.Id == document.CorrespondentId.Value)),
                _ => documents.Where(document => document.CorrespondentId == _selectedCorrespondent.Id)
            };
        }

        return documentType.Id switch
        {
            AllSelectionId => documents.Count(),
            UnassignedSelectionId => documents.Count(document => !document.DocumentTypeId.HasValue),
            PrivateSelectionId => documents.Count(document => document.DocumentTypeId.HasValue &&
                !_allDocumentTypes.Any(item => item.Id == document.DocumentTypeId.Value)),
            _ => documents.Count(document => document.DocumentTypeId == documentType.Id)
        };
    }

    private string GetPaperlessDocumentUrl(int documentId)
    {
        if (string.IsNullOrWhiteSpace(_paperlessBaseUrl))
        {
            throw new InvalidOperationException(
                "Die Paperless-Basisadresse ist für diese Sitzung nicht verfügbar.");
        }

        return $"{_paperlessBaseUrl}/documents/{documentId}/details";
    }

    private string BuildCompletedNavigationStatus(
        string prefix,
        int documentCount,
        string durationText,
        DateTimeOffset checkedAtUtc)
    {
        var checkedAtLocal = checkedAtUtc.ToLocalTime();
        var nextCheckLocal = checkedAtLocal.Add(TimeSpan.FromSeconds(15));

        return $"{prefix} · {documentCount:N0} Dokumente · " +
               $"Letzte Prüfung {durationText} am {checkedAtLocal:dd.MM.} um {checkedAtLocal:HH:mm:ss} · " +
               $"nächste um {nextCheckLocal:HH:mm:ss}";
    }

    private string NavigationStatusText => _isRefreshingNavigation && _syncStartedAt.HasValue
        ? _syncElapsedSeconds >= 15
            ? $"{_navigationStatus} {_syncElapsedSeconds} Sekunden · Paperless verarbeitet möglicherweise neue Dokumente"
            : $"{_navigationStatus} {_syncElapsedSeconds} Sekunden"
        : _navigationStatus;

    private void StartSyncStatusUpdates()
    {
        StopSyncStatusUpdates();
        _syncStatusCancellation = new CancellationTokenSource();
        _syncStatusTask = UpdateSyncStatusAsync(_syncStatusCancellation.Token);
    }

    private void StopSyncStatusUpdates()
    {
        if (_syncStatusCancellation is null) return;
        _syncStatusCancellation.Cancel();
        _syncStatusCancellation.Dispose();
        _syncStatusCancellation = null;
    }

    private async Task UpdateSyncStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!_syncStartedAt.HasValue) continue;
                _syncElapsedSeconds = Math.Max(0, (int)(DateTimeOffset.UtcNow - _syncStartedAt.Value).TotalSeconds);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string FormatSyncDuration()
    {
        if (!_syncStartedAt.HasValue) return "abgeschlossen";
        var seconds = Math.Max(0.1, (DateTimeOffset.UtcNow - _syncStartedAt.Value).TotalSeconds);
        return $"in {seconds:0.0} Sekunden";
    }

    private static string FormatLocalTime(
        DateTimeOffset timestamp)
    {
        return timestamp
            .ToLocalTime()
            .ToString("dd.MM. HH:mm:ss");
    }

    private string SelectedAreaClass(AreaDefinition area) =>
        _selectedArea?.StoragePathId == area.StoragePathId
            ? "selected"
            : string.Empty;

    private string SelectedCorrespondentClass(CorrespondentDto correspondent) =>
        _selectedCorrespondent?.Id == correspondent.Id
            ? "selected"
            : string.Empty;

    private string SelectedDocumentTypeClass(DocumentTypeDto documentType) =>
        _selectedDocumentType?.Id == documentType.Id
            ? "selected"
            : string.Empty;

    private sealed record AreaDefinition(
        int StoragePathId,
        string DisplayName,
        string PaperlessName);
}
