    private void ApplyStoragePaths(
        IReadOnlyList<StoragePathDto> storagePaths)
    {
        var previousSelectedStoragePathId =
            _selectedArea?.StoragePathId;

        var dynamicAreas = storagePaths
            .Where(item =>
                item.Id > 0 &&
                !string.IsNullOrWhiteSpace(item.Name))
            .GroupBy(item => item.Id)
            .Select(group => group.First())
            .OrderBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(item => item.Id)
            .Select(item => new AreaDefinition(
                item.Id,
                item.Name.Trim(),
                string.Empty))
            .ToArray();

        _areas =
        [
            new AreaDefinition(
                UnassignedAreaKey,
                "Nicht zugewiesen",
                "ohne Speicherpfad"),
            .. dynamicAreas
        ];

        if (!previousSelectedStoragePathId.HasValue)
        {
            return;
        }

        _selectedArea = _areas.FirstOrDefault(area =>
            area.StoragePathId == previousSelectedStoragePathId.Value);

        if (_selectedArea is null)
        {
            _selectedCorrespondent = null;
            _selectedDocumentType = null;
            _selectedDocument = null;
            _currentIndex = null;
            _areaCorrespondents = [];
            _documentTypes = [];
            _documents = [];
            _totalCount = 0;
            CloseDocumentInspectorInternal();
        }
    }

    private void RebuildAreasForSnapshot(NavigationCacheSnapshot snapshot)
    {
        var readableIds = _areas.Where(area => area.StoragePathId > 0)
            .Select(area => area.StoragePathId).ToHashSet();
        var hasPrivate = snapshot.Documents.Any(document =>
            document.StoragePathId.HasValue && !readableIds.Contains(document.StoragePathId.Value));

        _areas = hasPrivate
            ? [.. _areas.Where(area => area.StoragePathId != PrivateAreaKey), PrivateArea]
            : [.. _areas.Where(area => area.StoragePathId != PrivateAreaKey)];
    }

    private IReadOnlyCollection<int>? GetSelectedPrivateStoragePathIds()
    {
        if (_selectedArea?.StoragePathId != PrivateAreaKey || _navigationSnapshot is null) return null;
        var readable = _areas.Where(area => area.StoragePathId > 0)
            .Select(area => area.StoragePathId).ToHashSet();
        return _navigationSnapshot.Documents
            .Where(document => document.StoragePathId.HasValue && !readable.Contains(document.StoragePathId.Value))
            .Select(document => document.StoragePathId!.Value).Distinct().ToArray();
    }

    private IReadOnlyCollection<int>? GetSelectedPrivateCorrespondentIds()
    {
        if (_selectedCorrespondent?.Id != PrivateSelectionId || _currentIndex is null) return null;
        var readable = _allCorrespondents.Select(item => item.Id).ToHashSet();
