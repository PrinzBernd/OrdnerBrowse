    private IEnumerable<NavigationDocumentDto> DocumentsForArea(AreaDefinition area)
    {
        if (_navigationSnapshot is null) return [];

        var readableIds = _areas.Where(item => item.StoragePathId > 0)
            .Select(item => item.StoragePathId).ToHashSet();

        return area.StoragePathId switch
        {
            AllAreaKey => _navigationSnapshot.Documents,
            PrivateAreaKey => _navigationSnapshot.Documents.Where(document =>
                document.StoragePathId.HasValue && !readableIds.Contains(document.StoragePathId.Value)),
            UnassignedAreaKey => _navigationSnapshot.Documents.Where(document => !document.StoragePathId.HasValue),
            _ => _navigationSnapshot.Documents.Where(document => document.StoragePathId == area.StoragePathId)
        };
    }

